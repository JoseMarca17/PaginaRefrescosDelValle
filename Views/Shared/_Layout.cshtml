<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Refrescos del Valle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,800;0,900;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/styles.css"/>
    <link rel="stylesheet" href="~/css/dashboard.css"/>

    <style>
        :root {
            --header-h: 70px;
            --sidebar-width: 260px;
            --dark-950: #050202;
            --dark-900: #0a0303;
            --dark-800: #1a0f0f;
            --dark-700: #2a1a1a;
            --dark-600: #3a2525;
            --red-400: #e55a4e;
            --red-500: #d82c20;
            --red-600: #C8281E;
            --red-700: #a81f16;
            --red-800: #8a1a12;
            --gray-300: #d4d4d4;
            --gray-400: #9ca3af;
            --gray-500: #6b7280;
            --gray-600: #4b5563;
            --white: #ffffff;
            --font-display: 'Playfair Display', serif;
            --font-mono: 'DM Mono', monospace;
            --font-body: 'Plus Jakarta Sans', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background: var(--dark-900);
            color: var(--white);
        }

        /* ══════════════════════════════════════
           NAVBAR
        ══════════════════════════════════════ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;                          /* FIX: forzar ancho completo */
            z-index: 200;
            height: var(--header-h);
            background: rgba(10, 3, 3, 0.97);
            border-bottom: 1px solid rgba(200, 40, 30, 0.3);
            backdrop-filter: blur(12px);
        }

        .nav-inner {
            width: 100%;
            height: 100%;
            padding: 0 1.5rem 0 0;               /* FIX: sin padding izquierdo, el hamburguesa toca el borde */
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0;
            box-sizing: border-box;
        }

        /* Grupo izquierdo: hamburguesa + logo */
        .nav-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
            padding-left: 0.5rem;                 /* pequeño respiro del borde, no 1.5rem */
        }

        
        .btn-toggle-sidebar {
            display: flex;                         /* FIX: era display:none */
            background: var(--dark-800);
            border: 1px solid var(--dark-600);
            color: var(--white);
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .btn-toggle-sidebar svg { stroke: var(--white); display: block; }
        .btn-toggle-sidebar:hover { background: var(--red-600); border-color: var(--red-500); }

        /* Brand */
        .nav-brand {
            display: flex; align-items: center;
            gap: 0.75rem; text-decoration: none;
        }
        .logo-mark {
            width: 40px; height: 40px;
            border-radius: 10px; overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
        .logo-fallback {
            font-family: var(--font-display);
            font-size: 1.1rem; font-weight: 800; color: var(--red-600);
        }
        .brand-text { display: flex; flex-direction: column; }
        .brand-name {
            font-family: var(--font-display);
            font-size: 1.1rem; font-weight: 800; color: var(--white); line-height: 1.2;
        }
        .brand-highlight { color: var(--red-500); font-style: italic; }
        .brand-sub {
            font-size: 0.6rem; color: var(--gray-400);
            font-family: var(--font-mono); letter-spacing: 1px;
        }

        /* Nav links — centro */
        .nav-links {
            display: flex; align-items: center; gap: 0.25rem;
            background: rgba(0,0,0,0.3); padding: 0.25rem; border-radius: 60px;
        }
        .nav-link {
            color: var(--gray-400); text-decoration: none;
            font-size: 0.85rem; font-weight: 500;
            padding: 0.45rem 1rem; border-radius: 60px;
            transition: all 0.2s; white-space: nowrap;
        }
        .nav-link:hover { color: var(--white); background: rgba(200,40,30,0.2); }
        .nav-link.active { color: var(--white); background: var(--red-600); }

        /* Acciones derecha */
        .nav-actions { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }

        /* Menú usuario */
        .nav-user-menu { position: relative; }
        .nav-user-trigger {
            display: flex; align-items: center; gap: 0.5rem;
            padding: 0.3rem 0.75rem 0.3rem 0.4rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 60px; cursor: pointer; transition: all 0.2s;
        }
        .nav-user-trigger:hover { background: rgba(200,40,30,0.1); border-color: var(--red-600); }
        .nav-avatar {
            width: 30px; height: 30px; background: var(--red-600);
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-size: 0.75rem; font-weight: 700;
        }
        .nav-user-name { font-size: 0.8rem; font-weight: 600; color: var(--white); }
        .nav-user-role { font-size: 0.55rem; color: var(--red-400); font-family: var(--font-mono); }
        .nav-user-meta { display: flex; flex-direction: column; }
        .user-chevron { width: 14px; height: 14px; stroke: var(--gray-400); transition: transform 0.2s; }
        .nav-user-menu.open .user-chevron { transform: rotate(180deg); }

        /* Dropdown */
        .user-dropdown {
            position: absolute; top: calc(100% + 8px); right: 0;
            min-width: 220px; background: var(--dark-800);
            border: 1px solid var(--dark-600); border-radius: 12px;
            opacity: 0; visibility: hidden; transform: translateY(-8px);
            transition: all 0.2s; z-index: 300;
        }
        .nav-user-menu.open .user-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-header { padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-700); }
        .dropdown-user-full { font-size: 0.85rem; font-weight: 600; color: var(--white); }
        .dropdown-user-email { font-size: 0.65rem; color: var(--gray-500); margin-top: 0.2rem; }
        .dropdown-section { padding: 0.5rem 0; }
        .dropdown-section + .dropdown-section { border-top: 1px solid var(--dark-700); }
        .dropdown-item {
            display: flex; align-items: center; gap: 0.6rem;
            padding: 0.55rem 1rem; color: var(--gray-400);
            text-decoration: none; font-size: 0.8rem; transition: all 0.15s;
        }
        .dropdown-item:hover { background: rgba(200,40,30,0.1); color: var(--white); }
        .dropdown-item.danger:hover { background: rgba(220,38,38,0.15); color: var(--red-400); }
        .dropdown-item svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }

        /* Botón login */
        .nav-login-btn {
            display: inline-flex; align-items: center; gap: 0.5rem;
            background: var(--red-600); color: var(--white);
            text-decoration: none; padding: 0.45rem 1.2rem;
            border-radius: 60px; font-size: 0.85rem; font-weight: 600;
            transition: all 0.2s; border: none; cursor: pointer;
        }
        .nav-login-btn:hover { background: var(--red-500); transform: translateY(-1px); }
        .nav-login-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; }

        /* ══════════════════════════════════════
           PAGE SHELL
        ══════════════════════════════════════ */
        .page-shell {
            padding-top: var(--header-h);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .has-sidebar .page-body {
            display: flex;
            flex: 1;
            position: relative;
        }

        /* Sidebar fixed */
        .dashboard-sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            background: var(--dark-900);
            border-right: none;                   /* FIX: sin borde externo */
            position: fixed;
            top: var(--header-h);
            left: 0;
            height: calc(100vh - var(--header-h));
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            z-index: 100;
            transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
            scrollbar-width: thin;
            scrollbar-color: var(--dark-600) transparent;
        }
        .dashboard-sidebar::-webkit-scrollbar { width: 4px; }
        .dashboard-sidebar::-webkit-scrollbar-track { background: transparent; }
        .dashboard-sidebar::-webkit-scrollbar-thumb { background: var(--dark-600); border-radius: 4px; }

        .sidebar-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(3px);
            z-index: 150;
            opacity: 0; visibility: hidden;
            transition: all 0.3s ease;
        }

        .dashboard-wrapper {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            margin-left: var(--sidebar-width);
            padding: 0;                           /* FIX: sin padding — cada view maneja el suyo */
            transition: margin-left 0.3s cubic-bezier(0.4,0,0.2,1);
        }

        /* Clase helper para views que sí necesitan padding interno */
        .page-content {
            padding: 1.5rem 2rem;
            flex: 1;
        }

        .has-sidebar.sidebar-collapsed .dashboard-sidebar {
            transform: translateX(-100%);
        }
        .has-sidebar.sidebar-collapsed .dashboard-wrapper {
            margin-left: 0;
        }

        .no-sidebar .page-body { flex: 1; }
        .no-sidebar .public-content { flex: 1; }

        /* Sidebar internos */
        .sidebar-section-title {
            padding: 1.25rem 1rem 1rem;
            border-bottom: 1px solid var(--dark-700);
            flex-shrink: 0;
        }
        .sidebar-section-title span {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--gray-500);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav { padding: 0.75rem 0.5rem; flex: 1; overflow-y: auto; }
        .nav-section { margin-bottom: 0.25rem; }
        .nav-section-title {
            font-size: 0.6rem; font-family: var(--font-mono);
            color: var(--red-500); letter-spacing: 1px; text-transform: uppercase;
            padding: 0.6rem 0.75rem 0.3rem; display: block;
        }
        .nav-item {
            display: flex; align-items: center; gap: 0.6rem;
            padding: 0.55rem 0.75rem; border-radius: 8px;
            color: var(--gray-400); text-decoration: none;
            font-size: 0.82rem; font-weight: 500;
            transition: all 0.15s; margin-bottom: 1px;
        }
        .nav-item:hover { background: rgba(200,40,30,0.12); color: var(--white); }
        .nav-item.active { background: var(--red-600); color: var(--white); }
        .nav-item svg { flex-shrink: 0; }

        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid var(--dark-700);
            flex-shrink: 0;
        }
        .sidebar-user-info {
            display: flex; align-items: center; gap: 0.6rem;
            padding: 0.5rem; border-radius: 8px; margin-bottom: 0.5rem;
        }
        .sidebar-avatar {
            width: 32px; height: 32px; background: var(--red-600);
            border-radius: 50%; display: flex; align-items: center;
            justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
        }
        .sidebar-user-name { font-size: 0.8rem; font-weight: 600; color: var(--white); display: block; }
        .sidebar-user-role { font-size: 0.6rem; color: var(--gray-500); font-family: var(--font-mono); display: block; }
        .logout-btn {
            display: flex; align-items: center; gap: 0.6rem;
            padding: 0.5rem 0.75rem; border-radius: 8px;
            color: var(--gray-400); text-decoration: none;
            font-size: 0.8rem; transition: all 0.15s; width: 100%;
        }
        .logout-btn:hover { background: rgba(220,38,38,0.15); color: var(--red-400); }
        .logout-btn svg { stroke: currentColor; fill: none; stroke-width: 2; }

        /* Footer */
        .footer {
            background: var(--dark-950);
            border-top: 2px solid var(--red-800);
            padding: 3rem 2rem 0;
            margin-top: auto;
        }
        .footer-inner {
            max-width: 1200px; margin: 0 auto;
            display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
            gap: 2rem; padding-bottom: 2.5rem;
        }
        .footer-brand-col { display: flex; flex-direction: column; gap: 1rem; }
        .footer-logo { display: flex; align-items: center; gap: 0.75rem; }
        .footer-brand-name { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--white); }
        .footer-brand-sub { font-size: 0.6rem; color: var(--gray-500); font-family: var(--font-mono); }
        .footer-desc { font-size: 0.8rem; color: var(--gray-500); line-height: 1.6; max-width: 250px; }
        .footer-social { display: flex; gap: 0.5rem; }
        .social-btn {
            width: 32px; height: 32px; background: var(--dark-700);
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; text-decoration: none; transition: all 0.2s;
        }
        .social-btn:hover { background: var(--red-600); transform: translateY(-2px); }
        .social-btn svg { width: 14px; height: 14px; stroke: var(--gray-400); fill: none; }
        .social-btn:hover svg { stroke: var(--white); }
        .footer-col { display: flex; flex-direction: column; gap: 0.5rem; }
        .footer-col-title {
            font-family: var(--font-mono); font-size: 0.65rem;
            color: var(--red-500); letter-spacing: 1px;
            text-transform: uppercase; margin-bottom: 0.25rem;
        }
        .footer-link {
            font-size: 0.8rem; color: var(--gray-500);
            text-decoration: none; transition: all 0.2s; display: inline-block;
        }
        .footer-link:hover { color: var(--white); transform: translateX(4px); }
        .footer-contact-item { display: flex; gap: 0.6rem; margin-bottom: 0.6rem; }
        .fci-icon { font-size: 0.9rem; }
        .fci-label { font-size: 0.6rem; color: var(--gray-500); font-family: var(--font-mono); display: block; }
        .fci-val { font-size: 0.75rem; color: var(--gray-300); display: block; }
        .footer-bottom {
            max-width: 1200px; margin: 0 auto;
            padding: 1.25rem 0; border-top: 1px solid var(--dark-700);
            display: flex; justify-content: space-between; align-items: center;
            font-size: 0.7rem; color: var(--gray-600); flex-wrap: wrap; gap: 1rem;
        }
        .footer-bottom-right { display: flex; gap: 1.5rem; }
        .footer-bottom-link { color: var(--gray-600); text-decoration: none; }
        .footer-bottom-link:hover { color: var(--gray-400); }

        /* Responsive */
        @@media (max-width: 992px) {
            .dashboard-sidebar { transform: translateX(-100%); }
            .has-sidebar.sidebar-open .dashboard-sidebar { transform: translateX(0); }
            .has-sidebar.sidebar-open .sidebar-overlay { opacity: 1; visibility: visible; }
            .dashboard-wrapper { margin-left: 0 !important; }
        }
        @@media (max-width: 900px) {
            .nav-links { display: none; }
            .brand-sub { display: none; }
            .footer-inner { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 600px) {
            .nav-user-meta { display: none; }
            .footer-inner { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; text-align: center; }
            .footer-bottom-right { flex-direction: column; gap: 0.5rem; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@{
    var userRole    = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var userName    = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
    var userEmail   = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";

    var rolesConSidebar = new[] { "SuperAdmin","AdminSeguridad","AdminProduccion","AdminInventario","AdminVentas","AdminCompras","AdminRRHH" };
    var tienesSidebar   = rolesConSidebar.Contains(userRole);
    var layoutClass     = tienesSidebar ? "has-sidebar" : "no-sidebar";
}

<!-- ══════════ NAVBAR ══════════ -->
<nav class="navbar" id="navbar">
    <div class="nav-inner">

        <div class="nav-left">
            @if (tienesSidebar)
            {
                <button class="btn-toggle-sidebar" id="btnToggleSidebar" aria-label="Toggle sidebar">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="6"  x2="21" y2="6"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
            }
            <a href="/" class="nav-brand">
                <div class="logo-mark">
                    <img src="/assets/img/LogoRefrescosDelValle.png" alt="Logo"
                         onerror="this.style.display='none'; this.parentElement.innerHTML='<span class=\'logo-fallback\'>RV</span>'"/>
                </div>
                <div class="brand-text">
                    <span class="brand-name">Refrescos del <span class="brand-highlight">Valle</span></span>
                    <span class="brand-sub">S.R.L. · Desde 1998</span>
                </div>
            </a>
        </div>

        <div class="nav-links">
            <a href="/"                 class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home"      ? "active" : "")">Inicio</a>
            <a href="/Pagina/Productos" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()     == "Productos"  ? "active" : "")">Productos</a>
            <a href="/Pagina/Nosotros"  class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()     == "Nosotros"   ? "active" : "")">Nosotros</a>
            <a href="/Pagina/Contacto"  class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()     == "Contacto"   ? "active" : "")">Contacto</a>
            @if (tienesSidebar)
            {
                <a href="/Dashboard" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">Dashboard</a>
            }
        </div>

        <div class="nav-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-user-menu" id="navUserMenu">
                    <div class="nav-user-trigger">
                        <div class="nav-avatar">@userInitial</div>
                        <div class="nav-user-meta">
                            <span class="nav-user-name">@userName</span>
                            <span class="nav-user-role">@userRole</span>
                        </div>
                        <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </div>
                    <div class="user-dropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-user-full">@userName</div>
                            <div class="dropdown-user-email">@userEmail</div>
                        </div>
                        <div class="dropdown-section">
                            @if (tienesSidebar)
                            {
                                <a href="/Dashboard" class="dropdown-item">
                                    <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>
                                    Dashboard
                                </a>
                            }
                            <a href="#" class="dropdown-item">
                                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Mi perfil
                            </a>
                        </div>
                        <div class="dropdown-section">
                            <a href="/Auth/Logout" class="dropdown-item danger">
                                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                Cerrar sesión
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a href="/Auth/Login" class="nav-login-btn">
                    <svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Iniciar sesión
                </a>
            }
        </div>

    </div>
</nav>

<!-- ══════════ SHELL ══════════ -->
<div class="page-shell @layoutClass" id="pageShell">

    @if (tienesSidebar)
    {
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <div class="page-body">

            <aside class="dashboard-sidebar">
                <nav class="sidebar-nav">
                    <a href="/Dashboard" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
                            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                            <path d="M9 22V12h6v10"/>
                        </svg>
                        <span>Dashboard</span>
                    </a>

                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("AdminSeguridad"))
                    {
                        <div class="nav-section">
                            <span class="nav-section-title">Seguridad</span>
                            <a href="/Seguridad/Index" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Seguridad"&&ViewContext.RouteData.Values["action"]?.ToString()=="Auditoria"?"active":"")">
                                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                <span>Indice</span>
                            </a>
                            <a href="/Seguridad/Sesiones" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Seguridad"&&ViewContext.RouteData.Values["action"]?.ToString()=="Sesiones"?"active":"")">

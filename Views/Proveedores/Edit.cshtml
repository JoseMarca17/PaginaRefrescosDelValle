@model RefrescosDelValle.Models.Entities.Proveedore

@{
    ViewData["Title"] = "Editar Proveedor";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-header">
    <div class="header-left">
        <a href="/Proveedores" class="back-button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Volver a Proveedores
        </a>
        <div>
            <h1 class="dashboard-title">Editar Proveedor</h1>
            <p class="dashboard-subtitle">Modificar datos de @Model.RazonSocial</p>
        </div>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProveedorId" />

    <div class="form-container">
        <div asp-validation-summary="ModelOnly" class="text-danger-modern"></div>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
            
            <div style="grid-column: span 2;">
                <label asp-for="PersonaId" class="form-label-modern">Contacto / Representante Legal *</label>
                <select asp-for="PersonaId" class="form-input-modern" asp-items="ViewBag.PersonaId">
                    <option value="">-- Seleccione el responsable --</option>
                </select>
                <span asp-validation-for="PersonaId" class="text-danger-modern"></span>
            </div>

            <div>
                <label asp-for="RazonSocial" class="form-label-modern">Razón Social *</label>
                <input asp-for="RazonSocial" class="form-input-modern" />
                <span asp-validation-for="RazonSocial" class="text-danger-modern"></span>
            </div>

            <div>
                <label asp-for="Nit" class="form-label-modern">NIT *</label>
                <input asp-for="Nit" class="form-input-modern" />
                <span asp-validation-for="Nit" class="text-danger-modern"></span>
            </div>

            <div>
                <label asp-for="Activo" class="form-label-modern">Estado del Proveedor</label>
                <select asp-for="Activo" class="form-input-modern">
                    <option value="true">Activo (Habilitado para compras)</option>
                    <option value="false">Inactivo (Suspendido)</option>
                </select>
            </div>

            <div style="grid-column: span 2;">
                <label asp-for="Observaciones" class="form-label-modern">Observaciones</label>
                <textarea asp-for="Observaciones" rows="3" class="form-input-modern" style="resize: vertical;"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger-modern"></span>
            </div>
        </div>

        <div class="info-note" style="border-color: rgba(255, 193, 7, 0.3); background: rgba(255, 193, 7, 0.05); color: #ffc107;">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="#ffc107" fill="none" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span><strong>Cuidado:</strong> Modificar la Razón Social o el NIT afectará cómo se visualizan las órdenes de compra anteriores.</span>
        </div>
    </div>

    <div style="display: flex; gap: 1rem;">
        <button type="submit" class="btn-warning-action">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                <polyline points="17 21 17 13 7 13 7 21"/>
                <polyline points="7 3 7 8 15 8"/>
            </svg>
            Actualizar Cambios
        </button>
        <a href="/Proveedores" class="btn-outline-modern">Cancelar</a>
    </div>
</form>

<style>
    .form-container { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; backdrop-filter: blur(10px); }
    .form-label-modern { display: block; color: var(--text-secondary); font-family: 'DM Mono', monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .form-input-modern { width: 100%; background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 0.7rem 1rem; color: var(--text-primary); font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; transition: all 0.3s; }
    .form-input-modern:focus { outline: none; border-color: #ffc107; box-shadow: 0 0 10px rgba(255, 193, 7, 0.2); }
    
    .text-danger-modern { color: #C8281E; font-size: 0.75rem; font-family: 'DM Mono', monospace; display: block; margin-top: 0.3rem; }
    
    .info-note { border: 1px solid; border-radius: 12px; padding: 1rem; margin-top: 1.5rem; display: flex; gap: 0.75rem; align-items: center; font-family: 'DM Mono', monospace; font-size: 0.8rem; }

    .btn-warning-action { background: #ffc107; color: #000; padding: 0.8rem 2rem; border-radius: 8px; border: none; font-family: 'DM Mono', monospace; font-weight: bold; font-size: 0.85rem; text-transform: uppercase; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 0.5rem; }
    .btn-warning-action:hover { background: #e0a800; transform: translateY(-2px); box-shadow: 0 0 20px rgba(255, 193, 7, 0.4); }
    
    .btn-outline-modern { background: transparent; color: var(--text-secondary); padding: 0.8rem 2rem; border-radius: 8px; border: 1px solid var(--border-color); text-decoration: none; font-family: 'DM Mono', monospace; font-size: 0.85rem; text-transform: uppercase; transition: all 0.3s; display: flex; align-items: center; justify-content: center; }
    .btn-outline-modern:hover { background: var(--input-bg); color: var(--text-primary); transform: translateY(-2px); }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@model RefrescosDelValle.Models.Entities.Producto

@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/css/modulos/productos.css" />

<!-- ═══════════════════════════════════════════════════════════════════ -->
<!-- HERO NEGRO RDV (Patrón oficial del sistema)                        -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
<div class="prod-hero">
    <div class="prod-hero-grid"></div>
    <div class="prod-hero-glow"></div>
    
    <div class="prod-hero-content">
        <div class="prod-hero-text">
            <div class="prod-eyebrow">
                <span class="prod-eyebrow-dot"></span>
                INVENTARIO · REGISTRO DE PRODUCTOS
            </div>
            <h1>
                Nuevo<br>
                <span class="prod-stroke">Producto</span>
            </h1>
            <div class="prod-hero-sub">
                Registra un nuevo producto en el sistema de inventario
            </div>
        </div>
        
        <div class="prod-hero-stats">
            <div class="prod-stat">
                <div class="prod-stat-value">+1</div>
                <div class="prod-stat-label">Nuevo registro</div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════ -->
<!-- SECCIÓN BLANCA RDV (Formulario - MISMO CÓDIGO ORIGINAL)            -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
<div class="prod-white-section">
    <div class="prod-container">

        <div class="prod-table-card">

            <div class="prod-table-header">
                <div>
                    <h2>➕ Nuevo Producto</h2>
                    <p>Registrar nuevo producto en el sistema</p>
                </div>
            </div>

            <div class="prod-form-container">

                <form asp-action="CrearProducto" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Nombre Producto -->
                    <div class="prod-form-group">
                        <label asp-for="NombreProducto"></label>
                        <input asp-for="NombreProducto" class="form-control" />
                        <span asp-validation-for="NombreProducto" class="text-danger"></span>
                    </div>

                    <!-- Código SKU -->
                    <div class="prod-form-group">
                        <label asp-for="CodigoSku">Código SKU</label>
                        <input asp-for="CodigoSku" class="form-control" />
                        <span asp-validation-for="CodigoSku" class="text-danger"></span>
                    </div>

                    <!-- Categoría -->
                    <div class="prod-form-group">
                        <label asp-for="CategoriaProductoId">Categoría</label>
                        <select asp-for="CategoriaProductoId"
                                asp-items="ViewBag.Categorias"
                                class="form-control">
                            <option value="">Seleccione una categoría</option>
                        </select>
                        <span asp-validation-for="CategoriaProductoId" class="text-danger"></span>
                    </div>

                    <!-- Unidad -->
                    <div class="prod-form-group">
                        <label asp-for="UnidadMedidaTexto">Unidad de Medida</label>
                        <input asp-for="UnidadMedidaTexto" class="form-control" />
                        <span asp-validation-for="UnidadMedidaTexto" class="text-danger"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="prod-form-group">
                        <label asp-for="Descripcion"></label>
                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <!-- Estado -->
                    <div class="prod-form-group">
                        <label>
                            <input asp-for="Activo" type="checkbox" />
                            Producto Activo
                        </label>
                    </div>

                    <!-- Botones -->
                    <div style="margin-top:30px; display:flex; gap:15px;">

                        <button type="submit" class="prod-btn-primary">
                            💾 Guardar Producto
                        </button>

                        <a asp-action="Productos" class="prod-btn-secondary">
                            ← Volver
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<!-- ═══════════════════════════════════════════════════════════════════ -->
<!-- MODAL RDV: Nueva Orden de Producción                               -->
<!-- ═══════════════════════════════════════════════════════════════════ -->
<div id="modalNuevaOrden" class="prod-modal" style="display: none;">
    <div class="prod-modal-content">
        <div class="prod-modal-header">
            <h3>➕ Nueva Orden de Producción</h3>
            <button class="prod-modal-close" id="modalCloseBtn">&times;</button>
        </div>
        <div class="prod-modal-body">
            <form id="formNuevaOrden">
                <div class="prod-form-group">
                    <label>Producto / Receta</label>
                    <select id="ordenProducto" required>
                        <option value="">Seleccionar receta...</option>
                        <option value="1">Refresco Cola v2.1.0</option>
                        <option value="2">Naranja Sabor Intenso v1.5.2</option>
                        <option value="3">Lima Limón Zero v3.0.0</option>
                        <option value="4">Uva Dark v1.2.0</option>
                        <option value="5">Toronja Rosada v2.0.0</option>
                    </select>
                </div>
                <div class="prod-form-group">
                    <label>Línea de Producción</label>
                    <select id="ordenLinea" required>
                        <option value="1">Línea 1 - Envasado</option>
                        <option value="2">Línea 2 - Carbonatación</option>
                        <option value="3">Línea 3 - Embotellado</option>
                    </select>
                </div>
                <div class="prod-form-group">
                    <label>Cantidad (Litros)</label>
                    <input type="number" id="ordenCantidad" step="100" min="100" placeholder="Ej: 5000" required>
                </div>
                <div class="prod-form-group">
                    <label>Fecha de Inicio Programada</label>
                    <input type="date" id="ordenFechaInicio" required>
                </div>
                <div class="prod-form-group">
                    <label>Notas Adicionales</label>
                    <textarea rows="3" placeholder="Instrucciones especiales, lote, observaciones..."></textarea>
                </div>
            </form>
        </div>
        <div class="prod-modal-footer">
            <button class="prod-btn-secondary" id="modalCancelBtn">Cancelar</button>
            <button class="prod-btn-primary" id="modalSubmitBtn">Crear Orden</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/modulos/produccion.js"></script>
    <script>
        // Script básico para el funcionamiento de tabs y modal
        (function() {
            // Tabs functionality
            const tabs = document.querySelectorAll('.prod-tab');
            const tabContents = {
                'progreso': document.getElementById('tab-progreso'),
                'planificadas': document.getElementById('tab-planificadas'),
                'historial': document.getElementById('tab-historial')
            };
            
            tabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    
                    // Remove active class from all tabs
                    tabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Hide all tab contents
                    Object.values(tabContents).forEach(content => {
                        if (content) content.style.display = 'none';
                    });
                    
                    // Show selected tab content
                    if (tabContents[tabId]) {
                        tabContents[tabId].style.display = 'block';
                    }
                });
            });
            
            // Modal functionality
            const modal = document.getElementById('modalNuevaOrden');
            const openModalBtns = document.getElementById('btnNuevaOrdenHero');
            const closeModalBtns = [document.getElementById('modalCloseBtn'), document.getElementById('modalCancelBtn')];
            
            function openModal() {
                modal.style.display = 'flex';
            }
            
            function closeModal() {
                modal.style.display = 'none';
            }
            
            if (openModalBtns) openModalBtns.addEventListener('click', openModal);
            closeModalBtns.forEach(btn => {
                if (btn) btn.addEventListener('click', closeModal);
            });
            
            // Close modal when clicking outside
            window.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            
            // Refresh button
            const refreshBtn = document.getElementById('btnRefresh');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', () => {
                    location.reload();
                });
            }
            
            // Export button
            const exportBtn = document.getElementById('btnExportar');
            if (exportBtn) {
                exportBtn.addEventListener('click', () => {
                    alert('Exportando historial de producción a CSV...');
                });
            }
        })();
    </script>
}
@model RefrescosDelValle.Models.ViewModels.EditarSucursalViewModel
@{
    ViewData["Title"] = "Editar Sucursal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ── HERO ── */
.es-hero {
    background: #0f0b09;
    padding: 2.8rem 2.5rem 2.2rem;
    position: relative; overflow: hidden;
}
.es-hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
        repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px),
        repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px);
}
.es-hero-glow {
    position: absolute; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(200,40,30,.10) 0%, transparent 70%);
    top: -180px; right: -60px; pointer-events: none;
}
.es-hero-inner {
    position: relative; z-index: 2;
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem; flex-wrap: wrap;
}
.es-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: monospace; font-size: .62rem;
    color: rgba(200,40,30,.85); letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: .5rem;
}
.es-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #C8281E; animation: espulse 2.5s ease infinite;
}
@@keyframes espulse {
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:.3;transform:scale(.5);}
}
.es-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 3vw, 2.3rem);
    color: #fff; line-height: 1; font-weight: 800;
    letter-spacing: 1px; margin-bottom: .3rem;
}
.es-hero-title .stroke { -webkit-text-stroke: 2px #C8281E; color: transparent; }
.es-hero-sub { font-size: .78rem; color: rgba(255,255,255,.32); line-height: 1.5; }
.es-breadcrumb {
    display: flex; align-items: center; gap: .45rem;
    font-family: monospace; font-size: .65rem;
    color: rgba(255,255,255,.25);
}
.es-breadcrumb a { color: rgba(200,40,30,.8); text-decoration: none; }
.es-breadcrumb a:hover { color: #C8281E; }

/* Hero stat chips */
.es-hero-right { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
.es-stat-chip {
    display: flex; flex-direction: column; align-items: center;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 10px; padding: .6rem 1.1rem;
}
.es-stat-chip-val {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.1rem; color: #C8281E; font-weight: 800; line-height: 1;
    max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.es-stat-chip-lbl {
    font-size: .54rem; font-family: monospace;
    color: rgba(255,255,255,.25); margin-top: .12rem;
    text-transform: uppercase; letter-spacing: 1px;
}

/* ── SECCIÓN BLANCA ── */
.es-white { background: #f7f5f4; padding: 2rem 2.5rem 3rem; }

/* Progreso */
.es-progress-bar {
    height: 3px; background: rgba(0,0,0,.06);
    border-radius: 999px; overflow: hidden; margin-bottom: .4rem;
}
.es-progress-fill {
    height: 100%; background: linear-gradient(90deg, #C8281E, #f1934c);
    border-radius: 999px; transition: width .3s ease; width: 0%;
}
.es-progress-lbl {
    font-size: .65rem; font-family: monospace;
    color: #9a8a84; text-align: right; margin-bottom: 1.5rem;
}

/* Cards */
.es-card {
    background: #fff; border: 1px solid rgba(0,0,0,.07);
    border-radius: 14px; overflow: hidden; margin-bottom: 1.5rem;
}
.es-card-header {
    display: flex; align-items: center; gap: .75rem;
    padding: .85rem 1.25rem;
    border-bottom: 1px solid rgba(0,0,0,.06);
    background: #faf9f8;
}
.es-card-header-icon {
    width: 30px; height: 30px; border-radius: 8px;
    background: rgba(200,40,30,.08); border: 1px solid rgba(200,40,30,.14);
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem; flex-shrink: 0;
}
.es-card-step {
    width: 22px; height: 22px; border-radius: 50%;
    background: #C8281E; color: #fff;
    font-family: monospace; font-size: .65rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.es-card-header-title {
    font-family: monospace; font-size: .68rem;
    text-transform: uppercase; letter-spacing: .1em;
    color: #18120f; font-weight: 700;
}
.es-card-header-sub { font-size: .7rem; color: #9a8a84; margin-top: .1rem; }
.es-card-body { padding: 1.5rem 1.25rem; }

/* Grid */
.es-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.es-full { grid-column: 1 / -1; }

/* Campos */
.es-field { display: flex; flex-direction: column; gap: .4rem; }
.es-label {
    font-size: .7rem; font-weight: 700; color: #5a4a44;
    text-transform: uppercase; letter-spacing: .06em;
    font-family: monospace; display: flex; align-items: center; gap: .3rem;
}
.es-label .req { color: #C8281E; }
.es-input-wrap { position: relative; }
.es-input-wrap svg {
    position: absolute; left: .85rem; top: 50%;
    transform: translateY(-50%); pointer-events: none;
    stroke: #9a8a84; transition: stroke .2s;
}
.es-input {
    width: 100%; background: #faf9f8;
    border: 1px solid rgba(0,0,0,.1); border-radius: 9px;
    color: #18120f; padding: .65rem .9rem .65rem 2.4rem;
    font-size: .85rem; outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
    box-sizing: border-box; font-family: inherit;
}
.es-input.no-icon { padding-left: .9rem; }
.es-input:focus {
    border-color: #C8281E;
    box-shadow: 0 0 0 3px rgba(200,40,30,.1);
    background: #fff;
}
.es-input::placeholder { color: #c9b9b3; }
.es-select {
    width: 100%; background: #faf9f8;
    border: 1px solid rgba(0,0,0,.1); border-radius: 9px;
    color: #18120f; padding: .65rem 2.5rem .65rem .9rem;
    font-size: .85rem; outline: none; font-family: inherit;
    transition: border-color .2s, box-shadow .2s;
    box-sizing: border-box; appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='%239a8a84' stroke-width='2' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolyline points='6 9 12 15 18 9'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right .9rem center;
}
.es-select:focus { border-color: #C8281E; box-shadow: 0 0 0 3px rgba(200,40,30,.1); }
.es-hint { font-size: .7rem; color: #9a8a84; }
.text-danger { color: #e74c3c; font-size: .72rem; display: block; }

/* Preview card */
.es-preview {
    background: #faf9f8; border: 1px solid rgba(0,0,0,.08);
    border-radius: 10px; padding: 1rem 1.1rem;
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
}
.es-preview-icon {
    width: 42px; height: 42px; border-radius: 10px;
    background: rgba(200,40,30,.08); border: 1px solid rgba(200,40,30,.14);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; flex-shrink: 0;
}
.es-preview-name {
    font-size: .92rem; font-weight: 700; color: #18120f;
    font-family: 'Playfair Display', Georgia, serif;
}
.es-preview-meta { font-size: .72rem; color: #9a8a84; font-family: monospace; margin-top: .15rem; }
.es-preview-id {
    margin-left: auto;
    font-family: monospace; font-size: .68rem;
    background: rgba(200,40,30,.06); border: 1px solid rgba(200,40,30,.14);
    color: #a81f16; padding: .2rem .6rem; border-radius: 6px; font-weight: 700;
}

/* Barra de acciones */
.es-actions-bar {
    background: #fff; border: 1px solid rgba(0,0,0,.07);
    border-radius: 14px; padding: 1rem 1.25rem;
    display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 1rem;
}
.es-actions-info { font-size: .74rem; color: #9a8a84; font-family: monospace; line-height: 1.6; }
.es-actions-info strong { color: #C8281E; }
.es-actions-btns { display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
.es-btn-cancel {
    display: inline-flex; align-items: center; gap: .4rem;
    background: #faf9f8; color: #5a4a44;
    border: 1px solid rgba(0,0,0,.1); border-radius: 999px;
    padding: .55rem 1.3rem; font-size: .78rem; font-weight: 700;
    text-decoration: none; transition: all .18s; font-family: inherit;
}
.es-btn-cancel:hover { border-color: #9a8a84; color: #18120f; }
.es-btn-submit {
    display: inline-flex; align-items: center; gap: .4rem;
    background: #C8281E; color: #fff; border: none;
    border-radius: 999px; padding: .55rem 1.5rem;
    font-size: .78rem; font-weight: 700; cursor: pointer;
    transition: all .18s; font-family: inherit;
    box-shadow: 0 2px 10px rgba(200,40,30,.3);
}
.es-btn-submit:hover { background: #a81f16; transform: translateY(-1px); }

/* Responsive */
@@media (max-width: 700px) {
    .es-white { padding: 1.5rem 1rem 2rem; }
    .es-hero  { padding: 2rem 1rem 1.8rem; }
    .es-grid-2 { grid-template-columns: 1fr; }
    .es-full { grid-column: 1; }
    .es-hero-right { display: none; }
}
</style>
}

<!-- ══ HERO ══ -->
<div class="es-hero">
    <div class="es-hero-grid"></div>
    <div class="es-hero-glow"></div>
    <div class="es-hero-inner">
        <div>
            <div class="es-eyebrow">
                <span class="es-eyebrow-dot"></span>
                Infraestructura · Sucursales
            </div>
            <h1 class="es-hero-title">EDITAR <span class="stroke">SUCURSAL</span></h1>
            <p class="es-hero-sub">Modifica los datos operativos y ubicación de la sucursal.</p>
        </div>
        <div class="es-hero-right">
            <div class="es-stat-chip">
                <span class="es-stat-chip-val" id="esPreviewNombreChip">@Model.NombreSucursal</span>
                <span class="es-stat-chip-lbl">Sucursal</span>
            </div>
            <div class="es-stat-chip">
                <span class="es-stat-chip-val">ID @Model.SucursalId</span>
                <span class="es-stat-chip-lbl">Registro</span>
            </div>
            <nav class="es-breadcrumb">
                <a asp-controller="Seguridad" asp-action="Sucursales">Sucursales</a>
                <span style="color:rgba(255,255,255,.15)">›</span>
                <span>Editar</span>
            </nav>
        </div>
    </div>
</div>

<!-- ══ SECCIÓN BLANCA ══ -->
<div class="es-white">

    <!-- Progreso -->
    <div class="es-progress-bar">
        <div class="es-progress-fill" id="esProgressFill"></div>
    </div>
    <div class="es-progress-lbl">Completitud: <span id="esProgressPct">0</span>%</div>

    <form asp-controller="Seguridad" asp-action="EditarSucursal" method="post" id="esForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SucursalId" />

        <!-- ── CARD 1: Identificación ── -->
        <div class="es-card">
            <div class="es-card-header">
                <div class="es-card-step">1</div>
                <div class="es-card-header-icon">🏢</div>
                <div>
                    <div class="es-card-header-title">Identificación de la Sucursal</div>
                    <div class="es-card-header-sub">Nombre y ciudad donde opera</div>
                </div>
            </div>
            <div class="es-card-body">
                <div class="es-grid-2">
                    <div class="es-field es-full">
                        <label class="es-label" asp-for="NombreSucursal">
                            Nombre de la Sucursal <span class="req">*</span>
                        </label>
                        <div class="es-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                            <input asp-for="NombreSucursal" class="es-input"
                                   placeholder="Ej. Sucursal Centro"
                                   oninput="calcProgress(); actualizarPreview()" />
                        </div>
                        <span asp-validation-for="NombreSucursal" class="text-danger"></span>
                    </div>
                    <div class="es-field es-full">
                        <label class="es-label" asp-for="CiudadId">
                            Ciudad <span class="req">*</span>
                        </label>
                        <select asp-for="CiudadId" class="es-select"
                                asp-items="ViewBag.Ciudades"
                                onchange="calcProgress(); actualizarPreview()">
                            <option value="">— Seleccionar ciudad —</option>
                        </select>
                        <span asp-validation-for="CiudadId" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CARD 2: Datos de contacto ── -->
        <div class="es-card">
            <div class="es-card-header">
                <div class="es-card-step">2</div>
                <div class="es-card-header-icon">📍</div>
                <div>
                    <div class="es-card-header-title">Datos de Contacto y Ubicación</div>
                    <div class="es-card-header-sub">Dirección física y teléfono de la sucursal</div>
                </div>
            </div>
            <div class="es-card-body">
                <div class="es-grid-2">
                    <div class="es-field es-full">
                        <label class="es-label" asp-for="Direccion">Dirección</label>
                        <div class="es-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            <input asp-for="Direccion" class="es-input"
                                   placeholder="Ej. Av. Principal #123, Zona Centro"
                                   oninput="calcProgress()" />
                        </div>
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                    <div class="es-field">
                        <label class="es-label" asp-for="Telefono">Teléfono</label>
                        <div class="es-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.72 19 19.5 19.5 0 0 1 5 12.29a19.79 19.79 0 0 1-2-8.7A2 2 0 0 1 5.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            <input asp-for="Telefono" class="es-input"
                                   placeholder="Ej. 591-4-1234567"
                                   oninput="calcProgress()" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                        <span class="es-hint">Máximo 15 caracteres</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CARD 3: Vista previa ── -->
        <div class="es-card">
            <div class="es-card-header">
                <div class="es-card-header-icon">👁</div>
                <div>
                    <div class="es-card-header-title">Vista Previa</div>
                    <div class="es-card-header-sub">Así quedará registrada la sucursal</div>
                </div>
            </div>
            <div class="es-card-body">
                <div class="es-preview">
                    <div class="es-preview-icon">🏢</div>
                    <div>
                        <div class="es-preview-name" id="esPreviewNombre">@Model.NombreSucursal</div>
                        <div class="es-preview-meta" id="esPreviewMeta">
                            @(string.IsNullOrEmpty(Model.Direccion) ? "Sin dirección" : Model.Direccion)
                            · @(string.IsNullOrEmpty(Model.Telefono) ? "Sin teléfono" : Model.Telefono)
                        </div>
                    </div>
                    <div class="es-preview-id">ID @Model.SucursalId</div>
                </div>
            </div>
        </div>

        <!-- ── BARRA DE ACCIONES ── -->
        <div class="es-actions-bar">
            <div class="es-actions-info">
                Editando: <strong>@Model.NombreSucursal</strong><br>
                ID Registro: <strong>@Model.SucursalId</strong>
            </div>
            <div class="es-actions-btns">
                <a asp-controller="Seguridad" asp-action="Sucursales" class="es-btn-cancel">
                    ← Cancelar
                </a>
                <button type="submit" class="es-btn-submit">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Guardar Cambios
                </button>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    function calcProgress() {
        const reqs = [
            document.querySelector('[name="NombreSucursal"]'),
            document.querySelector('[name="CiudadId"]'),
        ];
        const filled = reqs.filter(el => el && el.value.trim() !== '' && el.value !== '0').length;
        const pct = Math.round((filled / reqs.length) * 100);
        document.getElementById('esProgressFill').style.width = pct + '%';
        document.getElementById('esProgressPct').textContent = pct;
    }

    function actualizarPreview() {
        const nombre    = document.querySelector('[name="NombreSucursal"]')?.value.trim() || 'Sin nombre';
        const direccion = document.querySelector('[name="Direccion"]')?.value.trim()      || 'Sin dirección';
        const telefono  = document.querySelector('[name="Telefono"]')?.value.trim()       || 'Sin teléfono';
        const ciudadSel = document.querySelector('[name="CiudadId"]');
        const ciudadTxt = ciudadSel?.options[ciudadSel.selectedIndex]?.text || '';

        document.getElementById('esPreviewNombre').textContent    = nombre;
        document.getElementById('esPreviewNombreChip').textContent = nombre;
        document.getElementById('esPreviewMeta').textContent =
            (ciudadTxt && ciudadTxt !== '— Seleccionar ciudad —' ? ciudadTxt + ' · ' : '') +
            direccion + ' · ' + telefono;
    }

    document.addEventListener('DOMContentLoaded', () => {
        calcProgress();
        actualizarPreview();

        // Actualizar preview también cuando cambia dirección y teléfono
        document.querySelector('[name="Direccion"]')?.addEventListener('input', actualizarPreview);
        document.querySelector('[name="Telefono"]')?.addEventListener('input', actualizarPreview);
    });
</script>
}
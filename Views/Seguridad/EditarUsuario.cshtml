@model RefrescosDelValle.Models.ViewModels.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rolesDisponibles = ViewBag.RolesDisponibles as List<RefrescosDelValle.Models.Entities.Role> ?? new();
}

@section Styles {
<style>
/* ── HERO ── */
.eu-hero {
    background: #0f0b09;
    padding: 2.8rem 2.5rem 2.2rem;
    position: relative; overflow: hidden;
}
.eu-hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
        repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px),
        repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px);
}
.eu-hero-glow {
    position: absolute; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(200,40,30,.10) 0%, transparent 70%);
    top: -180px; right: -60px; pointer-events: none;
}
.eu-hero-inner {
    position: relative; z-index: 2;
    display: flex; align-items: center;
    justify-content: space-between; gap: 2rem; flex-wrap: wrap;
}
.eu-hero-left { display: flex; align-items: center; gap: 1.5rem; }
.eu-avatar-hero {
    width: 64px; height: 64px; border-radius: 50%;
    background: linear-gradient(135deg, #C8281E, #7a1a10);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem; font-weight: 800; color: #fff;
    border: 2px solid rgba(200,40,30,.3);
    box-shadow: 0 0 0 6px rgba(200,40,30,.06);
    flex-shrink: 0;
}
.eu-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: monospace; font-size: .62rem;
    color: rgba(200,40,30,.85); letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: .5rem;
}
.eu-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #C8281E; animation: eupulse 2.5s ease infinite;
}
@@keyframes eupulse {
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:.3;transform:scale(.5);}
}
.eu-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    color: #fff; line-height: 1; font-weight: 800;
    letter-spacing: 1px; margin-bottom: .3rem;
}
.eu-hero-sub { font-size: .78rem; color: rgba(255,255,255,.32); line-height: 1.5; }
.eu-breadcrumb {
    display: flex; align-items: center; gap: .45rem;
    font-family: monospace; font-size: .65rem;
    color: rgba(255,255,255,.25);
}
.eu-breadcrumb a { color: rgba(200,40,30,.8); text-decoration: none; }
.eu-breadcrumb a:hover { color: #C8281E; }
.eu-breadcrumb-sep { color: rgba(255,255,255,.15); }

/* ── SECCIÓN BLANCA ── */
.eu-white { background: #f7f5f4; padding: 2rem 2.5rem 3rem; }

/* ── CARDS ── */
.eu-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,.07);
    border-radius: 14px; overflow: hidden;
    margin-bottom: 1.5rem;
}
.eu-card-header {
    display: flex; align-items: center; gap: .75rem;
    padding: .85rem 1.25rem;
    border-bottom: 1px solid rgba(0,0,0,.06);
    background: #faf9f8;
}
.eu-card-header-icon {
    width: 30px; height: 30px; border-radius: 8px;
    background: rgba(200,40,30,.08);
    border: 1px solid rgba(200,40,30,.14);
    display: flex; align-items: center; justify-content: center;
    font-size: .85rem; flex-shrink: 0;
}
.eu-card-header-title {
    font-family: monospace; font-size: .68rem;
    text-transform: uppercase; letter-spacing: .1em;
    color: #18120f; font-weight: 700;
}
.eu-card-header-sub { font-size: .7rem; color: #9a8a84; margin-top: .1rem; }
.eu-card-body { padding: 1.5rem 1.25rem; }

/* ── GRID ── */
.eu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.eu-grid .full { grid-column: 1 / -1; }

/* ── CAMPOS ── */
.eu-field { display: flex; flex-direction: column; gap: .4rem; }
.eu-label {
    font-size: .74rem; font-weight: 700; color: #5a4a44;
    display: flex; align-items: center; gap: .3rem;
    text-transform: uppercase; letter-spacing: .05em; font-family: monospace;
}
.eu-label .req { color: #C8281E; }
.eu-input {
    width: 100%; background: #faf9f8;
    border: 1px solid rgba(0,0,0,.1); border-radius: 9px;
    color: #18120f; padding: .65rem .9rem;
    font-size: .85rem; outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
    box-sizing: border-box; font-family: inherit;
}
.eu-input:focus {
    border-color: #C8281E;
    box-shadow: 0 0 0 3px rgba(200,40,30,.1);
    background: #fff;
}
.eu-input::placeholder { color: #c9b9b3; }
.eu-hint { font-size: .7rem; color: #9a8a84; }
.text-danger { color: #e74c3c; font-size: .72rem; display: block; }

/* Input con ícono */
.eu-input-wrap { position: relative; }
.eu-input-wrap svg {
    position: absolute; left: .85rem; top: 50%;
    transform: translateY(-50%); pointer-events: none;
    stroke: #9a8a84;
}
.eu-input-wrap .eu-input { padding-left: 2.4rem; }
.eu-input-wrap .eu-input:focus ~ svg,
.eu-input-wrap .eu-input:focus + svg { stroke: #C8281E; }

/* Alerta contraseña */
.eu-pwd-notice {
    display: flex; align-items: center; gap: .6rem;
    background: rgba(200,40,30,.04);
    border: 1px solid rgba(200,40,30,.12);
    border-radius: 9px; padding: .65rem .9rem;
    font-size: .76rem; color: #9a8a84;
    margin-bottom: 1rem;
}
.eu-pwd-notice svg { stroke: #C8281E; flex-shrink: 0; }

/* Password toggle */
.eu-pwd-wrap { position: relative; }
.eu-pwd-toggle {
    position: absolute; right: .8rem; top: 50%;
    transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: #9a8a84; padding: 0; display: flex; align-items: center;
}
.eu-pwd-toggle:hover { color: #C8281E; }

/* Toggle activo */
.eu-toggle-row {
    display: flex; align-items: center; justify-content: space-between;
    background: #faf9f8; border: 1px solid rgba(0,0,0,.08);
    border-radius: 10px; padding: .8rem 1rem;
}
.eu-toggle-info {}
.eu-toggle-label { font-size: .83rem; font-weight: 700; color: #18120f; }
.eu-toggle-desc  { font-size: .72rem; color: #9a8a84; margin-top: .1rem; }
.eu-switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
.eu-switch input { opacity: 0; width: 0; height: 0; }
.eu-switch-slider {
    position: absolute; cursor: pointer; inset: 0;
    background: #d1c7c3; border-radius: 24px; transition: .3s;
}
.eu-switch-slider:before {
    content: ""; position: absolute;
    height: 18px; width: 18px; left: 3px; bottom: 3px;
    background: #fff; border-radius: 50%; transition: .3s;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
}
.eu-switch input:checked + .eu-switch-slider { background: #1a7a3c; }
.eu-switch input:checked + .eu-switch-slider:before { transform: translateX(20px); }

/* Roles chips */
.eu-roles-grid { display: flex; flex-wrap: wrap; gap: .5rem; }
.eu-rol-item input[type="checkbox"] { display: none; }
.eu-rol-chip {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .4rem 1rem; border-radius: 999px; font-size: .78rem;
    cursor: pointer; transition: all .2s; user-select: none;
    border: 1px solid rgba(0,0,0,.1); background: #faf9f8; color: #9a8a84;
    font-weight: 600;
}
.eu-rol-chip:hover { border-color: #C8281E; color: #C8281E; background: rgba(200,40,30,.04); }
.eu-rol-item input:checked + .eu-rol-chip {
    background: rgba(200,40,30,.08);
    border-color: #C8281E; color: #C8281E;
}
.eu-chip-check { opacity: 0; transition: opacity .15s; color: #1a7a3c; font-size: .65rem; font-weight: 700; }
.eu-rol-item input:checked + .eu-rol-chip .eu-chip-check { opacity: 1; }

.eu-roles-empty {
    font-size: .8rem; color: #9a8a84; font-style: italic;
    padding: .8rem; background: #faf9f8; border-radius: 8px;
    border: 1px dashed rgba(0,0,0,.1); text-align: center;
}

/* Barra de acciones */
.eu-actions-bar {
    background: #fff;
    border: 1px solid rgba(0,0,0,.07);
    border-radius: 14px; padding: 1rem 1.25rem;
    display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 1rem;
}
.eu-actions-info { font-size: .74rem; color: #9a8a84; font-family: monospace; }
.eu-actions-info strong { color: #C8281E; }
.eu-actions-btns { display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
.eu-btn-cancel {
    display: inline-flex; align-items: center; gap: .4rem;
    background: #faf9f8; color: #5a4a44;
    border: 1px solid rgba(0,0,0,.1); border-radius: 999px;
    padding: .55rem 1.3rem; font-size: .78rem; font-weight: 700;
    text-decoration: none; transition: all .18s; font-family: inherit;
}
.eu-btn-cancel:hover { border-color: #9a8a84; color: #18120f; }
.eu-btn-submit {
    display: inline-flex; align-items: center; gap: .4rem;
    background: #C8281E; color: #fff;
    border: none; border-radius: 999px;
    padding: .55rem 1.5rem; font-size: .78rem; font-weight: 700;
    cursor: pointer; transition: all .18s; font-family: inherit;
    box-shadow: 0 2px 10px rgba(200,40,30,.3);
}
.eu-btn-submit:hover { background: #a81f16; transform: translateY(-1px); }

/* Progreso de campos */
.eu-progress-bar {
    height: 3px; background: rgba(0,0,0,.06);
    border-radius: 999px; overflow: hidden; margin-bottom: .4rem;
}
.eu-progress-fill {
    height: 100%; background: linear-gradient(90deg, #C8281E, #f1934c);
    border-radius: 999px; transition: width .3s ease;
}
.eu-progress-lbl { font-size: .65rem; font-family: monospace; color: #9a8a84; text-align: right; }

/* Responsive */
@@media (max-width: 700px) {
    .eu-white { padding: 1.5rem 1rem 2rem; }
    .eu-hero  { padding: 2rem 1rem 1.8rem; }
    .eu-grid  { grid-template-columns: 1fr; }
    .eu-grid .full { grid-column: 1; }
}
</style>
}

@{
    var nombreCompleto = $"{Model.Nombres} {Model.ApellidoPat}".Trim();
}

<!-- ══ HERO ══ -->
<div class="eu-hero">
    <div class="eu-hero-grid"></div>
    <div class="eu-hero-glow"></div>
    <div class="eu-hero-inner">
        <div class="eu-hero-left">
            <div class="eu-avatar-hero">@Model.Iniciales</div>
            <div>
                <div class="eu-eyebrow">
                    <span class="eu-eyebrow-dot"></span>
                    Seguridad · Identidades
                </div>
                <h1 class="eu-hero-title">EDITAR USUARIO</h1>
                <p class="eu-hero-sub">Modifica acceso, roles y datos del operador.</p>
            </div>
        </div>
        <nav class="eu-breadcrumb">
            <a asp-controller="Seguridad" asp-action="DirectorioUsuarios">Directorio</a>
            <span class="eu-breadcrumb-sep">›</span>
            <span>@(string.IsNullOrWhiteSpace(nombreCompleto) ? "Editar" : nombreCompleto)</span>
        </nav>
    </div>
</div>

<!-- ══ SECCIÓN BLANCA ══ -->
<div class="eu-white">

    <!-- Progreso de completitud -->
    <div style="margin-bottom:1.5rem;">
        <div class="eu-progress-bar">
            <div class="eu-progress-fill" id="euProgressFill" style="width:0%"></div>
        </div>
        <div class="eu-progress-lbl">Completitud del formulario: <span id="euProgressPct">0</span>%</div>
    </div>

    <form asp-controller="Seguridad" asp-action="EditarUsuario" method="post" id="euForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UsuarioId" />
        <input type="hidden" asp-for="Iniciales" />

        <!-- ── CARD 1: Datos personales ── -->
        <div class="eu-card">
            <div class="eu-card-header">
                <div class="eu-card-header-icon">👤</div>
                <div>
                    <div class="eu-card-header-title">Datos Personales</div>
                    <div class="eu-card-header-sub">Nombre completo y datos de contacto</div>
                </div>
            </div>
            <div class="eu-card-body">
                <div class="eu-grid">
                    <div class="eu-field">
                        <label class="eu-label" asp-for="Nombres">Nombres <span class="req">*</span></label>
                        <input asp-for="Nombres" class="eu-input" placeholder="Ej. Juan Carlos" oninput="calcProgress()" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>
                    <div class="eu-field">
                        <label class="eu-label" asp-for="ApellidoPat">Apellido Paterno <span class="req">*</span></label>
                        <input asp-for="ApellidoPat" class="eu-input" placeholder="Ej. García" oninput="calcProgress()" />
                        <span asp-validation-for="ApellidoPat" class="text-danger"></span>
                    </div>
                    <div class="eu-field">
                        <label class="eu-label" asp-for="ApellidoMat">Apellido Materno</label>
                        <input asp-for="ApellidoMat" class="eu-input" placeholder="Opcional" />
                    </div>
                    <div class="eu-field">
                        <label class="eu-label" asp-for="TelefonoPrincipal">Teléfono</label>
                        <div class="eu-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 11.72 19 19.5 19.5 0 0 1 5 12.29a19.79 19.79 0 0 1-2-8.7A2 2 0 0 1 5.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L9.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            <input asp-for="TelefonoPrincipal" class="eu-input" placeholder="+591 7XXXXXXX" />
                        </div>
                    </div>
                    <div class="eu-field full">
                        <label class="eu-label" asp-for="CorreoPrincipal">Correo Electrónico</label>
                        <div class="eu-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                            <input asp-for="CorreoPrincipal" class="eu-input" placeholder="correo@empresa.com" />
                        </div>
                        <span asp-validation-for="CorreoPrincipal" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CARD 2: Credenciales ── -->
        <div class="eu-card">
            <div class="eu-card-header">
                <div class="eu-card-header-icon">🔑</div>
                <div>
                    <div class="eu-card-header-title">Credenciales de Acceso</div>
                    <div class="eu-card-header-sub">Usuario, contraseña y estado de la cuenta</div>
                </div>
            </div>
            <div class="eu-card-body">
                <div class="eu-pwd-notice">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Deja el campo de contraseña vacío si no deseas modificarla.
                </div>
                <div class="eu-grid">
                    <div class="eu-field">
                        <label class="eu-label" asp-for="NombreUsuario">Nombre de Usuario <span class="req">*</span></label>
                        <div class="eu-input-wrap">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <input asp-for="NombreUsuario" class="eu-input" placeholder="usuario@empresa.com" oninput="calcProgress()" />
                        </div>
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                    </div>
                    <div class="eu-field">
                        <label class="eu-label" asp-for="NuevaContrasena">Nueva Contraseña</label>
                        <div class="eu-pwd-wrap">
                            <input asp-for="NuevaContrasena" type="password" class="eu-input" id="euPwdInput"
                                   placeholder="Dejar vacío para no cambiar" style="padding-right:2.5rem;" />
                            <button type="button" class="eu-pwd-toggle" onclick="togglePwd()">
                                <svg id="euPwdEye" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
                    </div>
                    <div class="eu-field full">
                        <label class="eu-label">Estado de la Cuenta</label>
                        <div class="eu-toggle-row">
                            <div class="eu-toggle-info">
                                <div class="eu-toggle-label">Cuenta activa</div>
                                <div class="eu-toggle-desc">El usuario puede iniciar sesión en el sistema</div>
                            </div>
                            <label class="eu-switch">
                                <input type="checkbox" asp-for="Activo" id="euToggleActivo" onchange="actualizarToggleLabel()" />
                                <span class="eu-switch-slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CARD 3: Roles ── -->
        <div class="eu-card">
            <div class="eu-card-header">
                <div class="eu-card-header-icon">🛡</div>
                <div>
                    <div class="eu-card-header-title">Roles Asignados</div>
                    <div class="eu-card-header-sub">Define los permisos de acceso del operador</div>
                </div>
            </div>
            <div class="eu-card-body">
                @if (!rolesDisponibles.Any())
                {
                    <div class="eu-roles-empty">No hay roles activos registrados en el sistema.</div>
                }
                else
                {
                    <div class="eu-roles-grid" id="euRolesGrid">
                        @foreach (var rol in rolesDisponibles)
                        {
                            var seleccionado = Model.RolesSeleccionados.Contains(rol.RolId);
                            <label class="eu-rol-item">
                                <input type="checkbox" name="RolesSeleccionados" value="@rol.RolId"
                                       @(seleccionado ? "checked" : "") onchange="calcProgress()" />
                                <span class="eu-rol-chip">
                                    <span class="eu-chip-check">✓</span>
                                    @rol.NombreRol
                                </span>
                            </label>
                        }
                    </div>
                    <div style="margin-top:.75rem; font-size:.7rem; color:#9a8a84; font-family:monospace;">
                        <span id="euRolesCount">@Model.RolesSeleccionados.Count</span> rol(es) asignado(s)
                    </div>
                }
            </div>
        </div>

        <!-- ── BARRA DE ACCIONES ── -->
        <div class="eu-actions-bar">
            <div class="eu-actions-info">
                Editando: <strong>@(string.IsNullOrWhiteSpace(nombreCompleto) ? "Usuario" : nombreCompleto)</strong>
                &nbsp;·&nbsp; ID: <strong>@Model.UsuarioId</strong>
            </div>
            <div class="eu-actions-btns">
                <a asp-controller="Seguridad" asp-action="DirectorioUsuarios" class="eu-btn-cancel">
                    ← Cancelar
                </a>
                <button type="submit" class="eu-btn-submit">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Guardar Cambios
                </button>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
    // ── Ver/ocultar contraseña ──
    function togglePwd() {
        const inp = document.getElementById('euPwdInput');
        inp.type = inp.type === 'password' ? 'text' : 'password';
    }

    // ── Actualizar label del toggle ──
    function actualizarToggleLabel() {
        const chk = document.getElementById('euToggleActivo');
        const lbl = chk.closest('.eu-toggle-row').querySelector('.eu-toggle-label');
        if (lbl) lbl.textContent = chk.checked ? 'Cuenta activa' : 'Cuenta suspendida';
    }

    // ── Barra de progreso de completitud ──
    function calcProgress() {
        const campos = [
            document.querySelector('[name="Nombres"]'),
            document.querySelector('[name="ApellidoPat"]'),
            document.querySelector('[name="NombreUsuario"]'),
        ];
        const rolesChecked = document.querySelectorAll('[name="RolesSeleccionados"]:checked').length;
        let filled = campos.filter(c => c && c.value.trim() !== '').length;
        if (rolesChecked > 0) filled++;
        const total = campos.length + 1;
        const pct = Math.round((filled / total) * 100);
        document.getElementById('euProgressFill').style.width = pct + '%';
        document.getElementById('euProgressPct').textContent = pct;

        // Contador roles
        const countEl = document.getElementById('euRolesCount');
        if (countEl) countEl.textContent = rolesChecked;
    }

    document.addEventListener('DOMContentLoaded', () => {
        calcProgress();
        actualizarToggleLabel();
    });
</script>
}
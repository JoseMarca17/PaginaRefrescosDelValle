@model RefrescosDelValle.Models.Entities.Role
@{
    ViewData["Title"] = "Editar Rol";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var todosPermisos  = ViewBag.Permisos as List<RefrescosDelValle.Models.Entities.Permiso> ?? new();
    var permisosDelRol = ViewBag.PermisosDelRol as HashSet<int> ?? new();
    var modulos        = todosPermisos.GroupBy(p => p.Modulo).ToList();
    var moduloIconos   = new Dictionary<string, string>
    {
        ["Ventas"]     = "📈",
        ["Inventario"] = "📦",
        ["Produccion"] = "⚙️",
        ["RRHH"]       = "👥",
        ["Compras"]    = "🛒",
        ["Seguridad"]  = "🛡️",
    };
}

@section Styles {
<style>
.rc-hero {
    background: #0f0b09; padding: 3rem 2.5rem 2.5rem;
    position: relative; overflow: hidden;
}
.rc-hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
        repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px),
        repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(200,40,30,.04) 59px, rgba(200,40,30,.04) 60px);
}
.rc-hero-glow {
    position: absolute; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(200,40,30,.11) 0%, transparent 70%);
    top: -160px; left: -80px; pointer-events: none;
}
.rc-hero-inner { position: relative; z-index: 2; }
.rc-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: monospace; font-size: .64rem;
    color: rgba(200,40,30,.85); letter-spacing: 2px;
    text-transform: uppercase; margin-bottom: .9rem;
}
.rc-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #C8281E; display: inline-block;
    animation: rcpulse 2.5s ease infinite;
}
@@keyframes rcpulse { 0%,100%{opacity:1;}50%{opacity:.35;} }
.rc-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #fff; line-height: .95;
    letter-spacing: 2px; font-weight: 800; margin-bottom: .5rem;
}
.rc-hero-title .stroke { -webkit-text-stroke: 2px #C8281E; color: transparent; }
.rc-hero-sub { font-size: .82rem; color: rgba(255,255,255,.35); line-height: 1.6; max-width: 460px; }
.rc-white { background: #f7f5f4; padding: 2rem 2.5rem 3rem; }
.rc-errors { background: rgba(200,40,30,.06); border: 1px solid rgba(200,40,30,.2); border-radius: 10px; padding: .9rem 1.2rem; margin-bottom: 1.5rem; font-size: .82rem; color: #a81f16; }
.rc-grid { display: grid; grid-template-columns: 320px 1fr; gap: 1.5rem; align-items: start; }
.rc-card { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 14px; overflow: hidden; margin-bottom: 1rem; }
.rc-card:last-child { margin-bottom: 0; }
.rc-card-head { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(0,0,0,.06); display: flex; align-items: center; gap: .6rem; }
.rc-card-head-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: rgba(200,40,30,.08); font-size: .85rem; flex-shrink: 0; }
.rc-card-head-title { font-size: .84rem; font-weight: 700; color: #18120f; }
.rc-card-head-sub { font-size: .7rem; color: #9a8a84; margin-top: .1rem; }
.rc-card-body { padding: 1.25rem; }
.rc-field { margin-bottom: 1.1rem; }
.rc-label { display: block; font-size: .76rem; font-weight: 600; color: #5a4a44; margin-bottom: .38rem; }
.rc-label span { color: #C8281E; margin-left: .15rem; }
.rc-input, .rc-textarea { width: 100%; background: #faf9f8; border: 1px solid rgba(0,0,0,.12); border-radius: 8px; padding: .65rem .9rem; font-size: .85rem; color: #18120f; outline: none; transition: border-color .2s, background .2s; font-family: inherit; box-sizing: border-box; }
.rc-input:focus, .rc-textarea:focus { border-color: #C8281E; background: #fff; }
.rc-textarea { resize: vertical; min-height: 90px; line-height: 1.6; }
.rc-hint { font-size: .7rem; color: #9a8a84; margin-top: .28rem; line-height: 1.5; }
.rc-field-error { font-size: .7rem; color: #C8281E; margin-top: .3rem; display: block; }
.rc-toggle-row { display: flex; align-items: center; justify-content: space-between; padding: .75rem .9rem; background: #faf9f8; border: 1px solid rgba(0,0,0,.09); border-radius: 8px; }
.rc-toggle-label { font-size: .8rem; font-weight: 600; color: #5a4a44; }
.rc-toggle-sub { font-size: .68rem; color: #9a8a84; margin-top: .1rem; }
.rc-toggle-switch { position: relative; width: 42px; height: 24px; }
.rc-toggle-switch input { opacity: 0; width: 0; height: 0; }
.rc-toggle-slider { position: absolute; inset: 0; background: #ddd; border-radius: 999px; cursor: pointer; transition: background .2s; }
.rc-toggle-slider:before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: transform .2s; }
.rc-toggle-switch input:checked + .rc-toggle-slider { background: #1a7a3c; }
.rc-toggle-switch input:checked + .rc-toggle-slider:before { transform: translateX(18px); }
.rc-perms-counter { display: inline-flex; align-items: center; gap: .5rem; font-family: monospace; font-size: .7rem; color: #9a8a84; }
.rc-perms-count-num { background: #C8281E; color: #fff; border-radius: 999px; padding: .1rem .5rem; font-size: .65rem; font-weight: 700; transition: transform .15s; min-width: 22px; text-align: center; display: inline-block; }
.rc-module-block { margin-bottom: .85rem; }
.rc-module-header { display: flex; align-items: center; justify-content: space-between; padding: .6rem .8rem; background: #faf9f8; border: 1px solid rgba(0,0,0,.07); border-radius: 8px; margin-bottom: .5rem; }
.rc-module-name { font-family: monospace; font-size: .68rem; color: #5a4a44; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; display: flex; align-items: center; gap: .5rem; }
.rc-module-toggle { font-size: .65rem; color: #C8281E; background: rgba(200,40,30,.07); border: 1px solid rgba(200,40,30,.18); border-radius: 4px; padding: .12rem .45rem; cursor: pointer; font-family: inherit; transition: all .15s; }
.rc-module-toggle:hover { background: rgba(200,40,30,.15); }
.rc-perms-checks { display: flex; flex-wrap: wrap; gap: .5rem; padding: .25rem .4rem .5rem; }
.rc-perm-lbl { display: inline-flex; align-items: center; gap: .4rem; padding: .32rem .72rem; border-radius: 7px; border: 1px solid rgba(0,0,0,.1); background: #faf9f8; cursor: pointer; font-size: .75rem; color: #5a4a44; transition: all .15s; user-select: none; }
.rc-perm-lbl:hover { border-color: #C8281E; color: #C8281E; }
.rc-perm-lbl input { display: none; }
.rc-perm-lbl.checked { background: rgba(200,40,30,.07); border-color: rgba(200,40,30,.3); color: #a81f16; font-weight: 600; }
.rc-perm-lbl.checked::before { content: '✓ '; font-size: .62rem; }
.rc-summary-card { background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 14px; padding: 1.25rem; position: sticky; top: 1rem; }
.rc-summary-title { font-size: .78rem; font-weight: 700; color: #18120f; margin-bottom: 1rem; }
.rc-summary-row { display: flex; justify-content: space-between; font-size: .76rem; color: #5a4a44; padding: .35rem 0; border-bottom: 1px solid rgba(0,0,0,.04); }
.rc-summary-val { font-weight: 600; color: #18120f; font-family: monospace; }
.rc-summary-modules { margin-top: .75rem; }
.rc-summary-module-line { display: flex; align-items: center; justify-content: space-between; font-size: .72rem; padding: .22rem 0; color: #9a8a84; }
.rc-summary-module-count { font-family: monospace; font-size: .65rem; background: rgba(200,40,30,.07); color: #C8281E; border-radius: 4px; padding: .1rem .4rem; }
.rc-form-actions { display: flex; gap: .75rem; justify-content: flex-end; margin-top: 1.5rem; flex-wrap: wrap; }
.rc-btn-cancel { background: #fff; color: #5a4a44; border: 1px solid rgba(0,0,0,.12); border-radius: 999px; padding: .58rem 1.3rem; font-size: .82rem; cursor: pointer; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; transition: all .18s; }
.rc-btn-cancel:hover { border-color: #9a8a84; }
.rc-btn-save { background: #C8281E; color: #fff; border: none; border-radius: 999px; padding: .58rem 1.5rem; font-size: .82rem; font-weight: 700; cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; gap: .4rem; box-shadow: 0 2px 10px rgba(200,40,30,.3); transition: all .18s; }
.rc-btn-save:hover { background: #a81f16; transform: translateY(-1px); }
@@media (max-width: 860px) {
    .rc-grid { grid-template-columns: 1fr; }
    .rc-summary-card { position: static; }
    .rc-white, .rc-hero { padding: 2rem 1rem; }
}
</style>
}

<!-- HERO -->
<div class="rc-hero">
    <div class="rc-hero-grid"></div>
    <div class="rc-hero-glow"></div>
    <div class="rc-hero-inner">
        <div class="rc-eyebrow">
            <span class="rc-eyebrow-dot"></span>
            Seguridad · Gestión de accesos
        </div>
        <h1 class="rc-hero-title">
            EDITAR<br><span class="stroke">ROL DE ACCESO</span>
        </h1>
        <p class="rc-hero-sub">
            Modifica el nombre, descripción, estado y permisos asignados a este rol.
        </p>
    </div>
</div>

<!-- SECCIÓN BLANCA -->
<div class="rc-white">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="rc-errors">
            <strong>Corrige los siguientes errores:</strong>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-controller="Rol" asp-action="Edit" asp-route-id="@Model.RolId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RolId" value="@Model.RolId" />

        <div class="rc-grid">

            <!-- COLUMNA DERECHA: PERMISOS -->
            <div style="order:2;">
                <div class="rc-card">
                    <div class="rc-card-head">
                        <div class="rc-card-head-icon">🔐</div>
                        <div>
                            <div class="rc-card-head-title">Permisos por módulo</div>
                            <div class="rc-card-head-sub">Selecciona qué puede hacer este rol en cada área</div>
                        </div>
                    </div>
                    <div class="rc-card-body">
                        <div class="rc-perms-counter">
                            Permisos seleccionados:
                            <span class="rc-perms-count-num" id="contadorPermisos">0</span>
                        </div>
                        <div style="margin-top:1rem;">
                            @foreach (var grupo in modulos)
                            {
                                var icono = moduloIconos.TryGetValue(grupo.Key, out var ic) ? ic : "📋";
                                <div class="rc-module-block">
                                    <div class="rc-module-header">
                                        <span class="rc-module-name">
                                            <span>@icono</span> @grupo.Key
                                        </span>
                                        <button type="button" class="rc-module-toggle"
                                                onclick="toggleModulo('@grupo.Key', this)">
                                            ☐ Todos
                                        </button>
                                    </div>
                                    <div class="rc-perms-checks" id="modulo-@grupo.Key">
                                        @foreach (var perm in grupo)
                                        {
                                            var estaSeleccionado = permisosDelRol.Contains(perm.PermisoId);
                                            var accionIcono = perm.Accion switch {
                                                "Ver"      => "👁",
                                                "Crear"    => "➕",
                                                "Editar"   => "✏",
                                                "Eliminar" => "🗑",
                                                "Exportar" => "⬇",
                                                "Aprobar"  => "✅",
                                                _          => "•"
                                            };
                                            <label class="rc-perm-lbl @(estaSeleccionado ? "checked" : "")"
                                                   id="lbl-@perm.PermisoId">
                                                <input type="checkbox"
                                                       name="permisosSeleccionados"
                                                       value="@perm.PermisoId"
                                                       checked="@estaSeleccionado"
                                                       onchange="onPermCheck(this, @perm.PermisoId)"/>
                                                <span>@accionIcono @perm.Accion</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA IZQUIERDA: DATOS + RESUMEN -->
            <div style="order:1;">

                <div class="rc-card">
                    <div class="rc-card-head">
                        <div class="rc-card-head-icon">📝</div>
                        <div>
                            <div class="rc-card-head-title">Datos del rol</div>
                            <div class="rc-card-head-sub">Nombre e identificación interna</div>
                        </div>
                    </div>
                    <div class="rc-card-body">
                        <div class="rc-field">
                            <label class="rc-label">
                                Nombre del rol <span>*</span>
                            </label>
                            <input name="NombreRol" class="rc-input"
                                   value="@Model.NombreRol"
                                   placeholder="ej. AdminVentas, SuperAdmin…"
                                   oninput="actualizarResumen()" required/>
                            <div class="rc-hint">Sin espacios, preferiblemente PascalCase.</div>
                            <span asp-validation-for="NombreRol" class="rc-field-error"></span>
                        </div>
                        <div class="rc-field">
                            <label class="rc-label">Descripción</label>
                            <textarea name="Descripcion" class="rc-textarea"
                                      placeholder="Describe el alcance de este rol…"
                                      oninput="actualizarResumen()">@Model.Descripcion</textarea>
                        </div>
                        <div class="rc-field">
                            <div class="rc-toggle-row">
                                <div>
                                    <div class="rc-toggle-label">Estado del rol</div>
                                    <div class="rc-toggle-sub">Desactivar impide su asignación a nuevos usuarios</div>
                                </div>
                                <label class="rc-toggle-switch">
                                    <input type="checkbox" name="Activo" value="true"
                                           @(Model.Activo ? "checked" : "") />
                                    <span class="rc-toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RESUMEN -->
                <div class="rc-summary-card">
                    <div class="rc-summary-title">📋 Resumen del rol</div>
                    <div class="rc-summary-row">
                        <span>Nombre</span>
                        <span class="rc-summary-val" id="sumNombre">@Model.NombreRol</span>
                    </div>
                    <div class="rc-summary-row">
                        <span>Total permisos</span>
                        <span class="rc-summary-val" id="sumTotal">@permisosDelRol.Count</span>
                    </div>
                    <div class="rc-summary-row">
                        <span>Creado</span>
                        <span class="rc-summary-val">@(Model.FechaCreacion != DateTime.MinValue ? Model.FechaCreacion.ToString("dd/MM/yyyy") : "—")</span>
                    </div>
                    <div class="rc-summary-modules" id="sumModulos"></div>

                    <div class="rc-form-actions">
                        <a asp-controller="Seguridad" asp-action="Roles" class="rc-btn-cancel">
                            ← Cancelar
                        </a>
                        <button type="submit" class="rc-btn-save">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                                 stroke="white" stroke-width="2.5" stroke-linecap="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            Guardar cambios
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', actualizarResumen);

function onPermCheck(cb, id) {
    document.getElementById('lbl-' + id)?.classList.toggle('checked', cb.checked);
    actualizarResumen();
}

function toggleModulo(nombre, btn) {
    const wrap   = document.getElementById('modulo-' + nombre);
    if (!wrap) return;
    const checks = wrap.querySelectorAll('input[type="checkbox"]');
    const todos  = Array.from(checks).every(c => c.checked);
    checks.forEach(c => { c.checked = !todos; onPermCheck(c, parseInt(c.value)); });
    btn.textContent = todos ? '☐ Todos' : '☑ Quitar';
}

function actualizarResumen() {
    const nombre = document.querySelector('input[name="NombreRol"]')?.value.trim() || '—';
    document.getElementById('sumNombre').textContent = nombre;

    const total = document.querySelectorAll('input[name="permisosSeleccionados"]:checked').length;
    const ctr   = document.getElementById('contadorPermisos');
    const sumT  = document.getElementById('sumTotal');
    ctr.textContent = total;
    ctr.style.transform = 'scale(1.2)';
    setTimeout(() => ctr.style.transform = '', 150);
    sumT.textContent = total;

    const sumMods = document.getElementById('sumModulos');
    sumMods.innerHTML = '';
    document.querySelectorAll('.rc-module-block').forEach(block => {
        const txt = block.querySelector('.rc-module-name')?.innerText?.trim() || '';
        const cnt = block.querySelectorAll('input:checked').length;
        if (!cnt) return;
        sumMods.innerHTML += `
            <div class="rc-summary-module-line">
                <span>${txt}</span>
                <span class="rc-summary-module-count">${cnt}</span>
            </div>`;
    });
}
</script>
}
@model RefrescosDelValle.Models.Entities.OrdenesCompra
@{
    ViewData["Title"] = "Crear Orden de Compra";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Nueva Orden de Compra</h1>
            <p class="page-description">Registra una orden a un proveedor</p>
        </div>
        <div class="page-actions">
            <a asp-action="OrdenesCompra" class="btn-outline">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Volver
            </a>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="CrearOrdenCompra" method="post">
            <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="ProveedorId" class="form-label required">Proveedor</label>
                    <select asp-for="ProveedorId" class="form-control" asp-items="ViewBag.Proveedores" required>
                        <option value="">-- Seleccione un proveedor --</option>
                    </select>
                    <span asp-validation-for="ProveedorId" class="form-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="ContratoId" class="form-label">Contrato asociado (opcional)</label>
                    <select asp-for="ContratoId" class="form-control" asp-items="ViewBag.Contratos">
                        <option value="">-- Sin contrato específico --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="FechaEntregaEsp" class="form-label">Fecha esperada de entrega</label>
                    <input asp-for="FechaEntregaEsp" type="date" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="MontoTotal" class="form-label required">Monto total (Bs.)</label>
                    <div class="input-prefix">
                        <span class="prefix">Bs</span>
                        <input asp-for="MontoTotal" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                    </div>
                    <span asp-validation-for="MontoTotal" class="form-error"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Observaciones" class="form-label">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Detalles de los productos, condiciones de entrega, etc."></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    Generar orden
                </button>
                <a asp-action="OrdenesCompra" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<style>
    /* Dashboard coherent styles — matching _DashboardLayout */
    .dashboard-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--light-100, #fef8f5);
        margin: 0 0 0.25rem 0;
        letter-spacing: -0.01em;
    }

    .page-description {
        color: var(--dark-300, #b8968c);
        font-size: 0.85rem;
        margin: 0;
    }

    .page-actions .btn-outline {
        background: transparent;
        border: 1px solid var(--red-600, #C8281E);
        color: var(--red-500, #e03a2e);
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 500;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        text-decoration: none;
    }

    .page-actions .btn-outline:hover {
        background: var(--red-600, #C8281E);
        color: white;
        border-color: var(--red-600, #C8281E);
    }

    /* Main form card */
    .form-card {
        background: var(--dark-800, #120a0a);
        border: 1px solid var(--dark-600, #2d1c1c);
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.4);
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--dark-100, #f3eae7);
    }

    .form-label.required::after {
        content: "*";
        color: var(--red-500, #C8281E);
        margin-left: 4px;
    }

    .form-control, .form-select {
        background: var(--dark-900, #050000);
        border: 1px solid var(--dark-600, #392424);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        color: var(--light-100, #fff5f0);
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
        outline: none;
        border-color: var(--red-500, #C8281E);
        box-shadow: 0 0 0 3px rgba(200, 40, 30, 0.2);
    }

    textarea.form-control {
        resize: vertical;
    }

    .input-prefix {
        display: flex;
        align-items: center;
        background: var(--dark-900, #050000);
        border: 1px solid var(--dark-600, #392424);
        border-radius: 12px;
        overflow: hidden;
    }

    .input-prefix .prefix {
        background: var(--dark-800, #1f1111);
        padding: 0 1rem;
        color: var(--dark-200, #d9bcb2);
        font-weight: 500;
        border-right: 1px solid var(--dark-600, #392424);
        line-height: 2.8rem;
    }

    .input-prefix .form-control {
        border: none;
        border-radius: 0;
        background: transparent;
        flex: 1;
    }

    .form-error {
        color: #f87171;
        font-size: 0.75rem;
        margin-top: 4px;
    }

    .alert-danger {
        background: rgba(200, 40, 30, 0.15);
        border-left: 4px solid #C8281E;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        color: #ffbbaf;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
        border-top: 1px solid var(--dark-600, #2d1c1c);
        padding-top: 1.8rem;
    }

    .btn-primary, .btn-secondary {
        padding: 0.7rem 1.5rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--red-600, #C8281E);
        color: white;
        box-shadow: 0 4px 8px rgba(200, 40, 30, 0.3);
    }

    .btn-primary:hover {
        background: #b32016;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: var(--dark-700, #2a1919);
        color: var(--light-200, #ffede5);
        border: 1px solid var(--dark-500, #533838);
    }

    .btn-secondary:hover {
        background: var(--dark-600, #3b2525);
        color: white;
    }

    
</style>
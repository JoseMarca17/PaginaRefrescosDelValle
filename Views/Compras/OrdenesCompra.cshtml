@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Órdenes de Compra";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">Órdenes de Compra</h1>
            <p class="page-description">Gestiona las órdenes de compra a proveedores</p>
        </div>
        <div class="page-actions">
            <a asp-action="CrearOrdenCompra" class="btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nueva orden
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="filter-card">
        <form asp-action="OrdenesCompra" method="get" class="filter-form">
            <div class="filter-grid">
                <div class="filter-group">
                    <label class="filter-label">Buscar</label>
                    <div class="input-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" name="searchString" class="form-control" placeholder="Nro. orden o proveedor" value="@ViewBag.CurrentFilter">
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Proveedor</label>
                    <select name="proveedorId" class="form-control" asp-items="ViewBag.Proveedores">
                        <option value="">Todos los proveedores</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Desde</label>
                    <input type="date" name="fechaDesde" class="form-control" value="@ViewBag.FechaDesde">
                </div>

                <div class="filter-group">
                    <label class="filter-label">Hasta</label>
                    <input type="date" name="fechaHasta" class="form-control" value="@ViewBag.FechaHasta">
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-secondary full-width">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        Filtrar
                    </button>
                    <a asp-action="OrdenesCompra" class="btn-outline full-width">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        Limpiar
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-success-custom">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>@TempData["Success"]</span>
            <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-error-custom">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@TempData["Error"]</span>
            <button type="button" class="alert-close" onclick="this.parentElement.remove()">×</button>
        </div>
    }

    <!-- Tabla -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nro. orden</th>
                        <th>Proveedor</th>
                        <th>Fecha emisión</th>
                        <th>Monto total</th>
                        <th>Progreso</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="order-number">#@item.NumeroOrden</td>
                                <td class="supplier-name">@item.ProveedorNombre</td>
                                <td class="date-cell">@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="amount-cell">Bs. @item.MontoTotal.ToString("N2")</td>
                                <td class="progress-cell">
                                    @{
                                        var porcentaje = item.MontoTotal > 0 ? (item.TotalRecibido / item.MontoTotal) * 100 : 0;
                                        var progressClass = porcentaje >= 100 ? "success" : porcentaje >= 70 ? "warning" : "primary";
                                    }
                                    <div class="progress-wrapper">
                                        <div class="progress-bar-custom @progressClass" style="width: @porcentaje%;">
                                            <span class="progress-text">@porcentaje.ToString("F0")%</span>
                                        </div>
                                    </div>
                                    <small class="recepcion-count">@item.CantidadRecepciones recepción(es)</small>
                                </td>
                                <td class="actions-cell">
                                    <div class="btn-group">
                                        <a asp-action="OrdenCompraDetails" asp-route-id="@item.OrdenCompraId" class="btn-icon" title="Ver detalles">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </a>
                                        <a asp-action="EditarOrdenCompra" asp-route-id="@item.OrdenCompraId" class="btn-icon" title="Editar">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M17 3l4 4-7 7H10v-4l7-7z"></path>
                                                <path d="M4 20h16"></path>
                                            </svg>
                                        </a>
                                        <form asp-action="EliminarOrdenCompra" asp-route-id="@item.OrdenCompraId" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta orden? Esta acción no se puede deshacer.');">
                                            <button type="submit" class="btn-icon delete" title="Eliminar">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                    <path d="M8 14h.01M12 14h.01M16 14h.01"></path>
                                </svg>
                                <p>No hay órdenes de compra registradas</p>
                                <a asp-action="CrearOrdenCompra" class="btn-primary small">Crear primera orden</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Dashboard consistent styles */
    .dashboard-page {
        padding: 0.5rem 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--light-100, #fef8f5);
        margin: 0 0 0.25rem 0;
        letter-spacing: -0.01em;
    }

    .page-description {
        color: var(--dark-300, #b8968c);
        font-size: 0.85rem;
        margin: 0;
    }

    .btn-primary, .btn-secondary, .btn-outline {
        padding: 0.7rem 1.5rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--red-600, #C8281E);
        color: white;
        box-shadow: 0 4px 8px rgba(200, 40, 30, 0.3);
    }

    .btn-primary:hover {
        background: #b32016;
        transform: translateY(-2px);
    }

    .btn-secondary {
        background: var(--dark-700, #2a1919);
        color: var(--light-200, #ffede5);
        border: 1px solid var(--dark-500, #533838);
    }

    .btn-secondary:hover {
        background: var(--dark-600, #3b2525);
        transform: translateY(-2px);
    }

    .btn-outline {
        background: transparent;
        border: 1px solid var(--dark-600, #392424);
        color: var(--dark-100, #f3eae7);
    }

    .btn-outline:hover {
        background: var(--dark-700, #2a1919);
        border-color: var(--red-600, #C8281E);
    }

    .full-width {
        width: 100%;
        justify-content: center;
    }

    /* Filter card */
    .filter-card {
        background: var(--dark-800, #120a0a);
        border: 1px solid var(--dark-600, #2d1c1c);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .filter-form {
        width: 100%;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .filter-label {
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--dark-200, #d9bcb2);
    }

    .input-icon {
        position: relative;
    }

    .input-icon svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        stroke: var(--dark-400, #6b4c42);
    }

    .input-icon .form-control {
        padding-left: 38px;
    }

    .filter-actions {
        display: flex;
        gap: 0.5rem;
    }

    /* Custom alerts */
    .alert-success-custom, .alert-error-custom {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.25rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        position: relative;
        animation: slideIn 0.3s ease;
    }

    .alert-success-custom {
        background: rgba(34, 197, 94, 0.15);
        border-left: 3px solid #22c55e;
        color: #86efac;
    }

    .alert-error-custom {
        background: rgba(200, 40, 30, 0.15);
        border-left: 3px solid #C8281E;
        color: #fca5a5;
    }

    .alert-close {
        margin-left: auto;
        background: none;
        border: none;
        color: inherit;
        font-size: 1.5rem;
        cursor: pointer;
        opacity: 0.7;
    }

    .alert-close:hover {
        opacity: 1;
    }


    /* Table card */
    .table-card {
        background: var(--dark-800, #120a0a);
        border: 1px solid var(--dark-600, #2d1c1c);
        border-radius: 20px;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table thead {
        background: var(--dark-900, #050000);
        border-bottom: 2px solid var(--red-600, #C8281E);
    }

    .data-table th {
        text-align: left;
        padding: 1rem 1.25rem;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--dark-200, #d9bcb2);
    }

    .data-table td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--dark-700, #1f1111);
        color: var(--light-100, #fff5f0);
    }

    .data-table tbody tr:hover {
        background: var(--dark-700, #1f1111);
        transition: background 0.2s;
    }

    .order-number {
        font-family: 'DM Mono', monospace;
        font-weight: 600;
        color: var(--red-500, #e03a2e);
    }

    .supplier-name {
        font-weight: 500;
    }

    .date-cell {
        font-family: 'DM Mono', monospace;
        font-size: 0.85rem;
        color: var(--dark-200, #d9bcb2);
    }

    .amount-cell {
        font-weight: 600;
        color: #22c55e;
    }

    /* Progress bar */
    .progress-cell {
        min-width: 160px;
    }

    .progress-wrapper {
        background: var(--dark-700, #1f1111);
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 0.25rem;
    }

    .progress-bar-custom {
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 600;
        transition: width 0.3s ease;
    }

    .progress-bar-custom.success {
        background: linear-gradient(90deg, #22c55e, #16a34a);
    }

    .progress-bar-custom.warning {
        background: linear-gradient(90deg, #f59e0b, #d97706);
    }

    .progress-bar-custom.primary {
        background: linear-gradient(90deg, #3b82f6, #2563eb);
    }

    .progress-text {
        color: white;
        text-shadow: 0 1px 1px rgba(0,0,0,0.3);
    }

    .recepcion-count {
        font-size: 0.7rem;
        color: var(--dark-300, #b8968c);
    }

    /* Actions */
    .actions-cell {
        text-align: right;
    }

    .btn-group {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn-icon {
        background: var(--dark-700, #1f1111);
        border: 1px solid var(--dark-600, #392424);
        border-radius: 8px;
        padding: 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        color: var(--dark-200, #d9bcb2);
    }

    .btn-icon:hover {
        background: var(--red-600, #C8281E);
        border-color: var(--red-600, #C8281E);
        color: white;
        transform: translateY(-2px);
    }

    .btn-icon.delete:hover {
        background: #dc2626;
        border-color: #dc2626;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 3rem !important;
    }

    .empty-state svg {
        stroke: var(--dark-500, #533838);
        margin-bottom: 1rem;
    }

    .empty-state p {
        color: var(--dark-300, #b8968c);
        margin-bottom: 1rem;
    }

    .btn-primary.small {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
    }

    .text-end {
        text-align: right;
    }


</style>
@model RefrescosDelValle.Models.ViewModels.InventarioIndexViewModel
@{
    ViewData["Title"] = "Módulo Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
<style>
/* ── TOKENS ── */
:root{
    --ii-red:    #C8281E; --ii-red-dk: #a81f16;
    --ii-hero:   #0f0b09; --ii-dark2:  #141010;
    --ii-white:  #f7f5f4; --ii-card:   #ffffff;
    --ii-card-hd:#faf9f8; --ii-dark:   #18120f;
    --ii-mid:    #5a4a44; --ii-muted:  #9a8a84;
    --ii-border: rgba(0,0,0,.07);
    --ii-green:  #1a7a3c; --ii-yellow: #b08d0a;
}

/* ── HERO ── */
.ii-hero{
    background:var(--ii-hero);
    min-height:88vh; display:flex; align-items:center;
    position:relative; overflow:hidden; padding:5rem 2.5rem;
}
.ii-hero-grid{
    position:absolute;inset:0;pointer-events:none;
    background-image:
        repeating-linear-gradient(0deg,transparent,transparent 59px,rgba(200,40,30,.04) 59px,rgba(200,40,30,.04) 60px),
        repeating-linear-gradient(90deg,transparent,transparent 59px,rgba(200,40,30,.04) 59px,rgba(200,40,30,.04) 60px);
}
.ii-glow-l{position:absolute;width:700px;height:700px;
    background:radial-gradient(circle,rgba(200,40,30,.1) 0%,transparent 70%);
    top:-200px;left:-150px;pointer-events:none}
.ii-glow-r{position:absolute;width:400px;height:400px;
    background:radial-gradient(circle,rgba(200,40,30,.06) 0%,transparent 70%);
    bottom:-100px;right:-60px;pointer-events:none}
.ii-hero-inner{
    max-width:1200px;margin:0 auto;width:100%;
    position:relative;z-index:2;
    display:grid;grid-template-columns:1fr 1fr;
    gap:4rem;align-items:center;
}

/* Eyebrow */
.ii-eyebrow{
    display:inline-flex;align-items:center;gap:.6rem;
    font-family:monospace;font-size:.66rem;
    color:rgba(200,40,30,.85);letter-spacing:2px;
    text-transform:uppercase;margin-bottom:1.4rem;
}
.ii-eyebrow-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--ii-red);display:inline-block;
    animation:iipulse 2.5s ease infinite;
}
@@keyframes iipulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.55)}}

/* Título */
.ii-hero-title{
    font-family:'Playfair Display',Georgia,serif;
    font-size:clamp(2.8rem,6vw,5.5rem);
    color:#fff;line-height:.92;
    letter-spacing:2px;font-weight:800;margin-bottom:1.4rem;
}
.ii-hero-title .stroke{-webkit-text-stroke:2px var(--ii-red);color:transparent}
.ii-hero-desc{
    font-size:.9rem;color:rgba(255,255,255,.32);
    line-height:1.75;max-width:460px;margin-bottom:2.5rem;
}

/* KPI strip */
.ii-kpi-strip{display:flex;align-items:center;flex-wrap:wrap;gap:0}
.ii-kpi-item{display:flex;flex-direction:column;padding:0 1.75rem}
.ii-kpi-item:first-child{padding-left:0}
.ii-kpi-val{
    font-family:'Playfair Display',Georgia,serif;
    font-size:2.2rem;color:var(--ii-red);line-height:1;font-weight:800;
}
.ii-kpi-lbl{
    font-size:.62rem;font-family:monospace;
    color:rgba(255,255,255,.22);
    text-transform:uppercase;letter-spacing:1.5px;margin-top:.2rem;
}
.ii-kpi-sep{width:1px;height:36px;background:rgba(255,255,255,.1)}

/* Module cards */
.ii-module-stack{display:flex;flex-direction:column;gap:1rem}
.ii-mcard{
    background:rgba(255,255,255,.03);
    border:1px solid rgba(255,255,255,.07);
    border-radius:14px;padding:1.4rem 1.6rem;
    display:flex;align-items:center;gap:1.25rem;
    text-decoration:none;position:relative;overflow:hidden;
    transition:border-color .22s,transform .2s,background .22s;
}
.ii-mcard::before{
    content:'';position:absolute;
    left:0;top:0;bottom:0;width:3px;
    background:var(--ii-red);
    transform:scaleY(0);transform-origin:bottom;transition:transform .22s;
}
.ii-mcard:hover{
    border-color:rgba(200,40,30,.45);
    transform:translateX(5px);
    background:rgba(200,40,30,.04);
}
.ii-mcard:hover::before{transform:scaleY(1)}
.ii-mcard-icon{
    width:50px;height:50px;flex-shrink:0;
    background:rgba(200,40,30,.1);
    border:1px solid rgba(200,40,30,.2);
    border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    transition:background .2s,border-color .2s;
}
.ii-mcard-icon svg{stroke:var(--ii-red)}
.ii-mcard:hover .ii-mcard-icon{background:rgba(200,40,30,.2);border-color:var(--ii-red)}
.ii-mcard-body{flex:1}
.ii-mcard-title{
    font-family:'Playfair Display',Georgia,serif;
    font-size:1.1rem;color:#fff;letter-spacing:.5px;margin-bottom:.3rem;
}
.ii-mcard-desc{font-size:.77rem;color:rgba(255,255,255,.32);line-height:1.5}
.ii-mcard-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.5rem}
.ii-badge{
    font-family:monospace;font-size:.58rem;
    color:rgba(200,40,30,.85);
    background:rgba(200,40,30,.1);border:1px solid rgba(200,40,30,.2);
    border-radius:999px;padding:.15rem .55rem;
}
.ii-badge.green{color:var(--ii-green);background:rgba(26,122,60,.08);border-color:rgba(26,122,60,.2)}
.ii-badge.yellow{color:var(--ii-yellow);background:rgba(176,141,10,.08);border-color:rgba(176,141,10,.25)}
.ii-mcard-arrow{
    width:32px;height:32px;flex-shrink:0;
    background:rgba(255,255,255,.05);border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    transition:background .18s,transform .18s;
}
.ii-mcard-arrow svg{stroke:rgba(255,255,255,.3)}
.ii-mcard:hover .ii-mcard-arrow{background:var(--ii-red);transform:translateX(2px)}
.ii-mcard:hover .ii-mcard-arrow svg{stroke:#fff}

/* ── SECCIÓN FLUJO (oscura) ── */
.ii-flow{
    background:var(--ii-dark2);padding:5rem 2.5rem;
    border-top:1px solid rgba(255,255,255,.04);
}
.ii-flow-inner{max-width:1200px;margin:0 auto}
.ii-stag{
    font-family:monospace;font-size:.63rem;
    color:rgba(200,40,30,.85);letter-spacing:2px;
    text-transform:uppercase;margin-bottom:.75rem;
    display:block;text-align:center;
}
.ii-stitle{
    font-family:'Playfair Display',Georgia,serif;
    font-size:clamp(1.8rem,3.5vw,2.8rem);
    color:#fff;letter-spacing:1px;
    text-align:center;margin-bottom:.5rem;
}
.ii-ssub{font-size:.84rem;color:rgba(255,255,255,.28);text-align:center;margin-bottom:3rem}
.ii-timeline{
    display:flex;align-items:flex-start;
    justify-content:center;flex-wrap:wrap;
}
.ii-fstep{
    display:flex;flex-direction:column;
    align-items:center;text-align:center;
    max-width:200px;gap:.75rem;
}
.ii-fnum{
    width:44px;height:44px;border-radius:50%;
    background:rgba(200,40,30,.15);
    border:2px solid rgba(200,40,30,.35);
    display:flex;align-items:center;justify-content:center;
    font-family:'Playfair Display',Georgia,serif;
    font-size:1.2rem;color:#fff;flex-shrink:0;
}
.ii-ftitle{font-family:'Playfair Display',Georgia,serif;font-size:.9rem;color:#fff;letter-spacing:.5px}
.ii-fdesc{font-size:.75rem;color:rgba(255,255,255,.28);line-height:1.6;margin-top:.3rem}
.ii-fconn{
    flex:1;min-width:40px;height:2px;
    background:rgba(200,40,30,.2);
    margin-top:21px;max-width:80px;
}

/* ── SECCIÓN ACCESO RÁPIDO (blanca) ── */
.ii-quick{background:var(--ii-white);padding:5rem 2.5rem}
.ii-quick-inner{max-width:1200px;margin:0 auto}
.ii-stag.dark{color:var(--ii-red)}
.ii-stitle.dark{color:var(--ii-dark)}
.ii-ssub.dark{color:var(--ii-muted)}
.ii-qa-grid{
    display:grid;grid-template-columns:repeat(3,1fr);
    gap:1.5rem;margin-top:2.5rem;
}
.ii-qa-card{
    background:#fff;border:1px solid var(--ii-border);
    border-radius:14px;padding:2rem;
    text-decoration:none;display:flex;flex-direction:column;
    transition:all .22s;position:relative;overflow:hidden;
}
.ii-qa-card::after{
    content:'';position:absolute;
    bottom:0;left:0;right:0;height:3px;
    background:var(--ii-red);
    transform:scaleX(0);transform-origin:left;transition:transform .25s;
}
.ii-qa-card:hover{
    border-color:rgba(200,40,30,.2);
    transform:translateY(-4px);
    box-shadow:0 12px 40px rgba(200,40,30,.1);
}
.ii-qa-card:hover::after{transform:scaleX(1)}
.ii-qa-icon{
    width:44px;height:44px;border-radius:12px;
    background:rgba(200,40,30,.08);
    border:1px solid rgba(200,40,30,.15);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:1.1rem;
}
.ii-qa-icon svg{stroke:var(--ii-red)}
.ii-qa-title{
    font-family:'Playfair Display',Georgia,serif;
    font-size:1.3rem;color:var(--ii-dark);
    letter-spacing:1px;margin-bottom:.75rem;
}
.ii-qa-desc{font-size:.81rem;color:var(--ii-mid);line-height:1.7;flex:1;margin-bottom:1.25rem}
.ii-qa-stats{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.5rem}
.ii-qa-stat{
    font-family:monospace;font-size:.62rem;color:var(--ii-red);
    background:rgba(200,40,30,.07);border:1px solid rgba(200,40,30,.15);
    border-radius:999px;padding:.2rem .65rem;
}
.ii-qa-stat.green{color:var(--ii-green);background:rgba(26,122,60,.07);border-color:rgba(26,122,60,.2)}
.ii-qa-stat.yellow{color:var(--ii-yellow);background:rgba(176,141,10,.07);border-color:rgba(176,141,10,.2)}
.ii-qa-cta{
    display:inline-flex;align-items:center;gap:.5rem;
    font-family:monospace;font-size:.72rem;
    color:var(--ii-red);margin-top:auto;
    transition:gap .18s;font-weight:600;
}
.ii-qa-cta svg{stroke:currentColor}
.ii-qa-card:hover .ii-qa-cta{gap:.85rem}

/* ── RESPONSIVE ── */
@@media(max-width:900px){
    .ii-hero{min-height:auto;padding:4rem 1.5rem}
    .ii-hero-inner{grid-template-columns:1fr;gap:3rem}
    .ii-qa-grid{grid-template-columns:1fr 1fr}
    .ii-flow,.ii-quick{padding:3.5rem 1.5rem}
}
@@media(max-width:640px){
    .ii-hero{padding:3rem 1.25rem}
    .ii-qa-grid{grid-template-columns:1fr}
    .ii-timeline{flex-direction:column;align-items:center}
    .ii-fconn{width:2px;height:30px;min-width:unset;margin-top:0}
    .ii-kpi-strip{gap:.5rem}
    .ii-kpi-item{padding:0 1rem}
    .ii-module-stack{gap:.75rem}
    .ii-mcard{padding:1.1rem 1.2rem}
}
</style>
}

<!-- ══ HERO ══ -->
<section class="ii-hero">
    <div class="ii-hero-grid"></div>
    <div class="ii-glow-l"></div>
    <div class="ii-glow-r"></div>

    <div class="ii-hero-inner">
        <!-- Izquierda: título + KPIs -->
        <div>
            <div class="ii-eyebrow">
                <span class="ii-eyebrow-dot"></span>
                SISTEMA · MÓDULO INVENTARIO
            </div>
            <h1 class="ii-hero-title">
                GESTIÓN DE<br>
                <span class="stroke">INVENTARIO</span>
            </h1>
            <p class="ii-hero-desc">
                Control centralizado de stock, almacenes por departamento y movimientos
                de mercancía a nivel nacional. Todo en tiempo real.
            </p>
            <div class="ii-kpi-strip">
                <div class="ii-kpi-item">
                    <span class="ii-kpi-val">@Model.TotalUnidades.ToString("N0")</span>
                    <span class="ii-kpi-lbl">Unidades</span>
                </div>
                <div class="ii-kpi-sep"></div>
                <div class="ii-kpi-item">
                    <span class="ii-kpi-val">@Model.TotalAlmacenes</span>
                    <span class="ii-kpi-lbl">Almacenes</span>
                </div>
                <div class="ii-kpi-sep"></div>
                <div class="ii-kpi-item">
                    <span class="ii-kpi-val">@Model.TotalDepartamentos</span>
                    <span class="ii-kpi-lbl">Departamentos</span>
                </div>
            </div>
        </div>

        <!-- Derecha: módulos -->
        <div class="ii-module-stack">
            <a asp-controller="Inventario" asp-action="Stock" class="ii-mcard">
                <div class="ii-mcard-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div class="ii-mcard-body">
                    <div class="ii-mcard-title">Stock</div>
                    <div class="ii-mcard-desc">Inventario disponible por departamento y producto.</div>
                    <div class="ii-mcard-tags">
                        <span class="ii-badge">@Model.TotalUnidades.ToString("N0") unidades</span>
                        <span class="ii-badge">@Model.TotalSKUs SKUs</span>
                        @if (Model.SKUsCriticos > 0)
                        {
                            <span class="ii-badge yellow">@Model.SKUsCriticos críticos</span>
                        }
                    </div>
                </div>
                <div class="ii-mcard-arrow">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke-width="2.5" stroke-linecap="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </a>

            <a asp-controller="Inventario" asp-action="Almacenes" class="ii-mcard">
                <div class="ii-mcard-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                    </svg>
                </div>
                <div class="ii-mcard-body">
                    <div class="ii-mcard-title">Almacenes</div>
                    <div class="ii-mcard-desc">Vista por departamento con estado y capacidad.</div>
                    <div class="ii-mcard-tags">
                        <span class="ii-badge">@Model.TotalAlmacenes total</span>
                        <span class="ii-badge green">@Model.AlmacenesActivos activos</span>
                        @if (Model.AlmacenesEnBaja > 0)
                        {
                            <span class="ii-badge yellow">@Model.AlmacenesEnBaja en baja</span>
                        }
                    </div>
                </div>
                <div class="ii-mcard-arrow">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke-width="2.5" stroke-linecap="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </a>

            <a asp-controller="Inventario" asp-action="Movimientos" class="ii-mcard">
                <div class="ii-mcard-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <polyline points="17 1 21 5 17 9"/>
                        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                        <polyline points="7 23 3 19 7 15"/>
                        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                    </svg>
                </div>
                <div class="ii-mcard-body">
                    <div class="ii-mcard-title">Movimientos</div>
                    <div class="ii-mcard-desc">Traslados, recepciones y mermas del mes.</div>
                    <div class="ii-mcard-tags">
                        <span class="ii-badge">@Model.MovimientosEsteMes este mes</span>
                        <span class="ii-badge green">@Model.TrasladosEsteMes traslados</span>
                        @if (Model.MermasEsteMes > 0)
                        {
                            <span class="ii-badge yellow">@Model.MermasEsteMes mermas</span>
                        }
                    </div>
                </div>
                <div class="ii-mcard-arrow">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke-width="2.5" stroke-linecap="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ══ FLUJO ══ -->
<section class="ii-flow">
    <div class="ii-flow-inner">
        <span class="ii-stag">CÓMO FUNCIONA</span>
        <h2 class="ii-stitle">Flujo de inventario</h2>
        <p class="ii-ssub">Desde la producción hasta la distribución, todo queda registrado</p>
        <div class="ii-timeline">
            <div class="ii-fstep">
                <div class="ii-fnum">1</div>
                <div>
                    <div class="ii-ftitle">Ingreso al almacén</div>
                    <p class="ii-fdesc">El producto fabricado se registra en el almacén de origen con su lote y cantidad.</p>
                </div>
            </div>
            <div class="ii-fconn"></div>
            <div class="ii-fstep">
                <div class="ii-fnum">2</div>
                <div>
                    <div class="ii-ftitle">Traslado interdepartamental</div>
                    <p class="ii-fdesc">Se genera un movimiento con origen, destino, fecha de envío y recepción confirmada.</p>
                </div>
            </div>
            <div class="ii-fconn"></div>
            <div class="ii-fstep">
                <div class="ii-fnum">3</div>
                <div>
                    <div class="ii-ftitle">Control de mermas</div>
                    <p class="ii-fdesc">Las pérdidas por rotura, caducidad o accidente se registran como merma con descripción.</p>
                </div>
            </div>
            <div class="ii-fconn"></div>
            <div class="ii-fstep">
                <div class="ii-fnum">4</div>
                <div>
                    <div class="ii-ftitle">Stock actualizado</div>
                    <p class="ii-fdesc">El inventario refleja en tiempo real el stock disponible en cada departamento del país.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══ ACCESO RÁPIDO ══ -->
<section class="ii-quick">
    <div class="ii-quick-inner">
        <span class="ii-stag dark">MÓDULOS</span>
        <h2 class="ii-stitle dark">Acceso rápido</h2>
        <p class="ii-ssub dark">Navega directamente a la sección que necesitas</p>
        <div class="ii-qa-grid">

            <a asp-controller="Inventario" asp-action="Stock" class="ii-qa-card">
                <div class="ii-qa-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div class="ii-qa-title">Stock</div>
                <p class="ii-qa-desc">Consulta el inventario disponible filtrando por departamento y producto. La tabla muestra unidades con estado de alerta por stock crítico.</p>
                <div class="ii-qa-stats">
                    <span class="ii-qa-stat">@Model.TotalUnidades.ToString("N0") unidades</span>
                    <span class="ii-qa-stat">@Model.TotalSKUs SKUs</span>
                    @if (Model.SKUsCriticos > 0)
                    {
                        <span class="ii-qa-stat yellow">@Model.SKUsCriticos críticos</span>
                    }
                </div>
                <span class="ii-qa-cta">
                    Ir a Stock
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </span>
            </a>

            <a asp-controller="Inventario" asp-action="Almacenes" class="ii-qa-card">
                <div class="ii-qa-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                    </svg>
                </div>
                <div class="ii-qa-title">Almacenes</div>
                <p class="ii-qa-desc">Visualiza los almacenes activos por departamento con su nombre, tipo y estado actual registrado en el sistema.</p>
                <div class="ii-qa-stats">
                    <span class="ii-qa-stat">@Model.TotalAlmacenes total</span>
                    <span class="ii-qa-stat green">@Model.AlmacenesActivos activos</span>
                    @if (Model.AlmacenesEnBaja > 0)
                    {
                        <span class="ii-qa-stat yellow">@Model.AlmacenesEnBaja en baja</span>
                    }
                </div>
                <span class="ii-qa-cta">
                    Ir a Almacenes
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </span>
            </a>

            <a asp-controller="Inventario" asp-action="Movimientos" class="ii-qa-card">
                <div class="ii-qa-icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="1.8" stroke-linecap="round">
                        <polyline points="17 1 21 5 17 9"/>
                        <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                        <polyline points="7 23 3 19 7 15"/>
                        <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                    </svg>
                </div>
                <div class="ii-qa-title">Movimientos</div>
                <p class="ii-qa-desc">Historial de traslados, recepciones y mermas con filtros por fecha y origen. Cada registro muestra cantidades y tipo de movimiento.</p>
                <div class="ii-qa-stats">
                    <span class="ii-qa-stat">@Model.MovimientosEsteMes este mes</span>
                    <span class="ii-qa-stat green">@Model.TrasladosEsteMes traslados</span>
                    @if (Model.MermasEsteMes > 0)
                    {
                        <span class="ii-qa-stat yellow">@Model.MermasEsteMes mermas</span>
                    }
                </div>
                <span class="ii-qa-cta">
                    Ir a Movimientos
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </span>
            </a>

        </div>
    </div>
</section>

@section Scripts {
<script>
    window.addEventListener('scroll', () =>
        document.getElementById('navbar')?.classList.toggle('scrolled', window.scrollY > 10));
</script>
}

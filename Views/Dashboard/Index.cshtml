@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using System.Security.Claims

@{
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.FindFirst(ClaimTypes.Name)?.Value;
}

@section Styles {
<style>
/* ═══════════════════════════════════════
   VARIABLES & BASE
═══════════════════════════════════════ */
:root {
    --rojo: #C8281E;
    --rojo-hover: #a81f16;
    --rojo-soft: rgba(200, 40, 30, 0.08);
    --rojo-mid: rgba(200, 40, 30, 0.15);
    --surface: #f7f5f4;
    --surface-2: #ffffff;
    --surface-3: #f0eeec;
    --border: rgba(0,0,0,0.07);
    --border-strong: rgba(0,0,0,0.13);
    --text-1: #18120f;
    --text-2: #5a4a44;
    --text-3: #9a8a84;
    --green: #1a7a3c;
    --green-soft: rgba(26,122,60,0.1);
    --blue: #1a4fa8;
    --blue-soft: rgba(26,79,168,0.1);
    --amber: #b45309;
    --amber-soft: rgba(180,83,9,0.1);
    --purple: #6d28d9;
    --purple-soft: rgba(109,40,217,0.1);
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.07), 0 2px 4px rgba(0,0,0,0.04);
    --shadow-lg: 0 10px 40px rgba(0,0,0,0.1), 0 4px 8px rgba(0,0,0,0.05);
    --radius: 14px;
    --radius-sm: 8px;
    --font-display: 'Playfair Display', serif;
    --font-mono: 'DM Mono', monospace;
    --font-body: 'Plus Jakarta Sans', sans-serif;
}

.db-root {
    background: var(--surface);
    min-height: 100vh;
    padding: 2rem 2.5rem 3rem;
    font-family: var(--font-body);
}

/* ═══════════════════════════════════════
   HEADER
═══════════════════════════════════════ */
.db-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
}

.db-header-left { display: flex; flex-direction: column; gap: 0.3rem; }

.db-eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.65rem;
    color: var(--rojo); letter-spacing: 2px; text-transform: uppercase;
}
.db-eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--rojo);
    animation: pulse 2.5s ease infinite;
}
@@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.65); }
}

.db-title {
    font-family: var(--font-display);
    font-size: 2rem; font-weight: 800;
    color: var(--text-1); line-height: 1.1;
    letter-spacing: -0.5px;
}
.db-subtitle {
    font-size: 0.88rem; color: var(--text-3);
    margin-top: 0.1rem;
}

.db-header-right {
    display: flex; align-items: center; gap: 0.75rem;
    flex-wrap: wrap;
}

.db-date-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 0.78rem; font-family: var(--font-mono);
    color: var(--text-2);
    box-shadow: var(--shadow-sm);
}
.db-date-chip svg { stroke: var(--text-3); }

.db-btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--rojo); color: white;
    border: none; border-radius: 999px;
    padding: 0.5rem 1.2rem;
    font-size: 0.78rem; font-weight: 600;
    font-family: var(--font-body);
    text-decoration: none; cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(200,40,30,0.3);
}
.db-btn-primary:hover {
    background: var(--rojo-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(200,40,30,0.35);
}
.db-btn-primary svg { stroke: white; }

/* ═══════════════════════════════════════
   KPI CARDS
═══════════════════════════════════════ */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.75rem;
}

.kpi-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
}
.kpi-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
}
.kpi-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 3px;
}
.kpi-card.red::before   { background: var(--rojo); }
.kpi-card.green::before { background: var(--green); }
.kpi-card.blue::before  { background: var(--blue); }
.kpi-card.purple::before{ background: var(--purple); }

.kpi-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1rem;
}
.kpi-icon {
    width: 40px; height: 40px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.kpi-icon.red    { background: var(--rojo-soft); }
.kpi-icon.green  { background: var(--green-soft); }
.kpi-icon.blue   { background: var(--blue-soft); }
.kpi-icon.purple { background: var(--purple-soft); }
.kpi-icon.red  svg { stroke: var(--rojo); }
.kpi-icon.green svg { stroke: var(--green); }
.kpi-icon.blue  svg { stroke: var(--blue); }
.kpi-icon.purple svg { stroke: var(--purple); }

.kpi-badge {
    font-family: var(--font-mono); font-size: 0.6rem;
    padding: 0.2rem 0.55rem; border-radius: 999px;
    font-weight: 500; letter-spacing: 0.5px;
}
.kpi-badge.up   { background: var(--green-soft); color: var(--green); }
.kpi-badge.down { background: var(--rojo-soft);  color: var(--rojo); }
.kpi-badge.neutral { background: var(--surface-3); color: var(--text-3); }

.kpi-val {
    font-family: var(--font-display);
    font-size: 2.2rem; font-weight: 800;
    color: var(--text-1); line-height: 1;
    margin-bottom: 0.3rem;
}
.kpi-label {
    font-size: 0.78rem; color: var(--text-3); font-weight: 500;
}

/* ═══════════════════════════════════════
   MAIN BODY LAYOUT
═══════════════════════════════════════ */
.db-body {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1rem;
    margin-bottom: 1.75rem;
}

/* ═══════════════════════════════════════
   MODULE CARDS
═══════════════════════════════════════ */
.modules-section { display: flex; flex-direction: column; gap: 1rem; }

.modules-section-title {
    font-family: var(--font-mono); font-size: 0.65rem;
    color: var(--text-3); letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 0.25rem;
}

.modules-grid-2col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.mod-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: block;
}
.mod-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    border-color: var(--rojo-mid);
}
.mod-card:hover .mod-arrow { transform: translateX(4px); opacity: 1; }

.mod-card-accent {
    position: absolute; top: 0; left: 0; bottom: 0; width: 3px;
}
.mod-card-accent.seg    { background: var(--rojo); }
.mod-card-accent.prod   { background: #d97706; }
.mod-card-accent.inv    { background: var(--blue); }
.mod-card-accent.ven    { background: var(--green); }
.mod-card-accent.comp   { background: #7c3aed; }
.mod-card-accent.rrhh   { background: #0891b2; }

.mod-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.85rem;
}
.mod-icon {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
}
.mod-icon.seg  { background: var(--rojo-soft); }
.mod-icon.seg  svg { stroke: var(--rojo); }
.mod-icon.prod { background: rgba(217,119,6,0.1); }
.mod-icon.prod svg { stroke: #d97706; }
.mod-icon.inv  { background: var(--blue-soft); }
.mod-icon.inv  svg { stroke: var(--blue); }
.mod-icon.ven  { background: var(--green-soft); }
.mod-icon.ven  svg { stroke: var(--green); }
.mod-icon.comp { background: rgba(124,58,237,0.1); }
.mod-icon.comp svg { stroke: #7c3aed; }
.mod-icon.rrhh { background: rgba(8,145,178,0.1); }
.mod-icon.rrhh svg { stroke: #0891b2; }

.mod-badge {
    font-family: var(--font-mono); font-size: 0.58rem;
    padding: 0.18rem 0.5rem; border-radius: 999px;
    background: var(--surface-3); color: var(--text-3);
    letter-spacing: 0.3px; white-space: nowrap;
}
.mod-badge.danger  { background: var(--rojo-soft); color: var(--rojo); }
.mod-badge.success { background: var(--green-soft); color: var(--green); }
.mod-badge.warning { background: var(--amber-soft); color: var(--amber); }

.mod-title {
    font-size: 0.92rem; font-weight: 700;
    color: var(--text-1); margin-bottom: 0.3rem;
    line-height: 1.3;
}
.mod-desc {
    font-size: 0.75rem; color: var(--text-3);
    line-height: 1.55; margin-bottom: 0.85rem;
}
.mod-stats-row {
    display: flex; gap: 0.4rem; flex-wrap: wrap;
    margin-bottom: 0.75rem;
}
.mod-stat-pill {
    font-size: 0.68rem; font-family: var(--font-mono);
    padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--surface-3); color: var(--text-2);
    border: 1px solid var(--border);
}
.mod-stat-pill.danger { background: var(--rojo-soft); color: var(--rojo); border-color: transparent; }

.mod-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
}
.mod-link {
    font-size: 0.75rem; font-weight: 600; color: var(--rojo);
    font-family: var(--font-mono);
}
.mod-arrow {
    stroke: var(--rojo); opacity: 0.5;
    transition: transform 0.2s, opacity 0.2s;
}

/* ═══════════════════════════════════════
   PANEL LATERAL
═══════════════════════════════════════ */
.side-panel { display: flex; flex-direction: column; gap: 1rem; }

/* Quick access */
.quick-card {
    background: var(--rojo);
    border-radius: var(--radius);
    padding: 1.5rem;
    position: relative; overflow: hidden;
    box-shadow: 0 4px 20px rgba(200,40,30,0.25);
}
.quick-card::before {
    content: 'RV';
    position: absolute; right: -0.5rem; bottom: -1rem;
    font-family: var(--font-display);
    font-size: 6rem; font-weight: 900;
    color: rgba(255,255,255,0.06);
    line-height: 1; pointer-events: none;
    letter-spacing: -4px;
}
.quick-title {
    font-family: var(--font-display);
    font-size: 1.05rem; font-weight: 700;
    color: white; margin-bottom: 0.3rem;
}
.quick-sub {
    font-size: 0.72rem; color: rgba(255,255,255,0.6);
    margin-bottom: 1.2rem;
}
.quick-links { display: flex; flex-direction: column; gap: 0.4rem; }
.quick-link {
    display: flex; align-items: center; gap: 0.6rem;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.8rem;
    text-decoration: none; color: white;
    font-size: 0.78rem; font-weight: 500;
    transition: all 0.15s;
}
.quick-link:hover { background: rgba(255,255,255,0.18); }
.quick-link svg { stroke: rgba(255,255,255,0.7); flex-shrink: 0; }

/* Sistema status */
.status-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-sm);
}
.status-card-title {
    font-family: var(--font-mono); font-size: 0.62rem;
    color: var(--text-3); letter-spacing: 1.5px;
    text-transform: uppercase; margin-bottom: 1rem;
}
.status-list { display: flex; flex-direction: column; gap: 0.6rem; }
.status-item {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem;
}
.status-item-left { display: flex; align-items: center; gap: 0.6rem; }
.status-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
}
.status-dot.ok     { background: var(--green); box-shadow: 0 0 0 2px var(--green-soft); }
.status-dot.warn   { background: var(--amber); box-shadow: 0 0 0 2px var(--amber-soft); }
.status-dot.alert  { background: var(--rojo);  box-shadow: 0 0 0 2px var(--rojo-soft); }
.status-item-name  { font-size: 0.78rem; color: var(--text-2); font-weight: 500; }
.status-item-val   { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-3); }

/* ═══════════════════════════════════════
   ACTIVIDAD RECIENTE
═══════════════════════════════════════ */
.activity-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}
.activity-card-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
}
.activity-card-title {
    font-size: 0.88rem; font-weight: 700; color: var(--text-1);
}
.activity-card-sub {
    font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-3);
    margin-top: 0.1rem;
}
.activity-see-all {
    font-family: var(--font-mono); font-size: 0.68rem;
    color: var(--rojo); text-decoration: none; font-weight: 500;
    padding: 0.3rem 0.75rem; border-radius: 999px;
    border: 1px solid var(--rojo-mid);
    transition: all 0.15s;
}
.activity-see-all:hover { background: var(--rojo-soft); }

.activity-list { padding: 0.5rem 0; }
.act-item {
    display: flex; align-items: flex-start; gap: 0.9rem;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
}
.act-item:last-child { border-bottom: none; }
.act-item:hover { background: var(--surface); }

.act-icon-wrap {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; margin-top: 0.1rem;
}
.act-icon-wrap.login  { background: var(--blue-soft); }
.act-icon-wrap.login  svg { stroke: var(--blue); }
.act-icon-wrap.venta  { background: var(--green-soft); }
.act-icon-wrap.venta  svg { stroke: var(--green); }
.act-icon-wrap.alerta { background: var(--rojo-soft); }
.act-icon-wrap.alerta svg { stroke: var(--rojo); }
.act-icon-wrap.default { background: var(--surface-3); }
.act-icon-wrap.default svg { stroke: var(--text-3); }

.act-content { flex: 1; min-width: 0; }
.act-text { font-size: 0.8rem; color: var(--text-2); line-height: 1.4; }
.act-time {
    font-family: var(--font-mono); font-size: 0.62rem;
    color: var(--text-3); margin-top: 0.2rem;
}

.act-empty {
    padding: 2.5rem 1.5rem; text-align: center;
    font-size: 0.8rem; color: var(--text-3);
}

/* ═══════════════════════════════════════
   DIVIDER LABEL
═══════════════════════════════════════ */
.section-label {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 0.85rem;
}
.section-label-text {
    font-family: var(--font-mono); font-size: 0.62rem;
    color: var(--text-3); letter-spacing: 2px; text-transform: uppercase;
    white-space: nowrap;
}
.section-label-line {
    flex: 1; height: 1px; background: var(--border);
}

/* ═══════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════ */
@@media (max-width: 1100px) {
    .db-body { grid-template-columns: 1fr; }
    .side-panel { flex-direction: row; flex-wrap: wrap; }
    .quick-card, .status-card { flex: 1; min-width: 260px; }
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 700px) {
    .db-root { padding: 1.25rem 1rem 2rem; }
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .modules-grid-2col { grid-template-columns: 1fr; }
    .db-header { flex-direction: column; }
}
@@media (max-width: 480px) {
    .kpi-grid { grid-template-columns: 1fr 1fr; }
}
</style>
}

<div class="db-root">

    <!-- HEADER -->
    <!-- HERO BANNER NEGRO -->
<section style="background:#0f0b09; padding:3.5rem 2.5rem 3rem; position:relative; overflow:hidden; margin:-2rem -2.5rem 2rem;">
    <div style="position:absolute;inset:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 59px,rgba(200,40,30,.04) 59px,rgba(200,40,30,.04) 60px),repeating-linear-gradient(90deg,transparent,transparent 59px,rgba(200,40,30,.04) 59px,rgba(200,40,30,.04) 60px);pointer-events:none;"></div>
    <div style="position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(200,40,30,.14) 0%,transparent 70%);top:-180px;right:-100px;pointer-events:none;"></div>
    <div style="position:relative;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;">
        <div>
            <div class="db-eyebrow" style="color:rgba(200,40,30,.9);">
                <span class="db-eyebrow-dot"></span>
                Panel de Control · Sistema
            </div>
            <h1 class="db-title" style="color:#fff; font-size:clamp(2.4rem,5vw,4rem); letter-spacing:2px;">
                BIENVENIDO,<br>
                <span style="-webkit-text-stroke:2px #C8281E; color:transparent;">@(userName?.Split(' ')[0]?.ToUpper() ?? "ADMINISTRADOR")</span>
            </h1>
            <p class="db-subtitle" style="color:rgba(255,255,255,.45);">
                Resumen operativo — @DateTime.Now.ToString("dddd dd 'de' MMMM 'de' yyyy")
            </p>
            <div style="display:flex;gap:2rem;margin-top:1.75rem;">
                <div style="display:flex;flex-direction:column;">
                    <span style="font-family:var(--font-display);font-size:1.8rem;color:#C8281E;line-height:1;font-weight:800;">@ViewBag.TotalProductos</span>
                    <span style="font-size:.62rem;font-family:var(--font-mono);color:rgba(255,255,255,.35);margin-top:.2rem;text-transform:uppercase;letter-spacing:1px;">Productos</span>
                </div>
                <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                <div style="display:flex;flex-direction:column;">
                    <span style="font-family:var(--font-display);font-size:1.8rem;color:#C8281E;line-height:1;font-weight:800;">@ViewBag.PedidosHoy</span>
                    <span style="font-size:.62rem;font-family:var(--font-mono);color:rgba(255,255,255,.35);margin-top:.2rem;text-transform:uppercase;letter-spacing:1px;">Pedidos hoy</span>
                </div>
                <div style="width:1px;background:rgba(255,255,255,.1);"></div>
                <div style="display:flex;flex-direction:column;">
                    <span style="font-family:var(--font-display);font-size:1.8rem;color:#C8281E;line-height:1;font-weight:800;">@ViewBag.TotalEmpleados</span>
                    <span style="font-size:.62rem;font-family:var(--font-mono);color:rgba(255,255,255,.35);margin-top:.2rem;text-transform:uppercase;letter-spacing:1px;">Empleados</span>
                </div>
            </div>
        </div>
        <div class="db-date-chip" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.5);">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="2" stroke-linecap="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>
</section>

    <!-- KPI GRID -->
    <div class="kpi-grid">
        <div class="kpi-card red">
            <div class="kpi-top">
                <div class="kpi-icon red">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="2" stroke-linecap="round">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
                    </svg>
                </div>
                <span class="kpi-badge neutral">Total</span>
            </div>
            <div class="kpi-val">@ViewBag.TotalProductos</div>
            <div class="kpi-label">Productos Activos</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-top">
                <div class="kpi-icon green">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="2" stroke-linecap="round">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                </div>
                <span class="kpi-badge up">↑ Hoy</span>
            </div>
            <div class="kpi-val">@ViewBag.PedidosHoy</div>
            <div class="kpi-label">Pedidos del Día</div>
        </div>
        <div class="kpi-card blue">
            <div class="kpi-top">
                <div class="kpi-icon blue">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="2" stroke-linecap="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                    </svg>
                </div>
                <span class="kpi-badge @(ViewBag.StockBajo > 5 ? "down" : "neutral")">Alerta</span>
            </div>
            <div class="kpi-val">@ViewBag.StockBajo</div>
            <div class="kpi-label">Stock Bajo</div>
        </div>
        <div class="kpi-card purple">
            <div class="kpi-top">
                <div class="kpi-icon purple">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke-width="2" stroke-linecap="round">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <span class="kpi-badge neutral">Activos</span>
            </div>
            <div class="kpi-val">@ViewBag.TotalEmpleados</div>
            <div class="kpi-label">Empleados</div>
        </div>
    </div>

    <!-- BODY: MÓDULOS + PANEL LATERAL -->
    <div class="db-body">

        <!-- MÓDULOS -->
        <div class="modules-section">
            <div class="section-label">
                <span class="section-label-text">Módulos del sistema</span>
                <div class="section-label-line"></div>
            </div>
            <div class="modules-grid-2col">

                @if (userRole == "SuperAdmin" || userRole == "AdminSeguridad")
                {
                    <a class="mod-card" href="/Seguridad/Index">
                        <div class="mod-card-accent seg"></div>
                        <div class="mod-top">
                            <div class="mod-icon seg">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                            </div>
                            <span class="mod-badge danger">Alta prioridad</span>
                        </div>
                        <div class="mod-title">Seguridad y Auditoría</div>
                        <div class="mod-desc">Usuarios, roles, permisos, bitácora de accesos y sucursales</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">@ViewBag.TotalUsuarios usuarios</span>
                            <span class="mod-stat-pill">@ViewBag.TotalSucursales sucursales</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Administrar →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

                @if (userRole == "SuperAdmin" || userRole == "AdminProduccion")
                {
                    <a class="mod-card" href="/Produccion/Index">
                        <div class="mod-card-accent prod"></div>
                        <div class="mod-top">
                            <div class="mod-icon prod">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                </svg>
                            </div>
                            <span class="mod-badge success">Activo</span>
                        </div>
                        <div class="mod-title">Producción y Recetas</div>
                        <div class="mod-desc">Productos, recetas, líneas de producción y órdenes activas</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">@ViewBag.ProduccionHoy órdenes hoy</span>
                            <span class="mod-stat-pill">@ViewBag.LineasActivas líneas</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Gestionar →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

                @if (userRole == "SuperAdmin" || userRole == "AdminInventario")
                {
                    <a class="mod-card" href="/Inventario/IndexInventario">
                        <div class="mod-card-accent inv"></div>
                        <div class="mod-top">
                            <div class="mod-icon inv">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 7h8M8 12h8M8 17h4"/>
                                </svg>
                            </div>
                            <span class="mod-badge warning">Atención</span>
                        </div>
                        <div class="mod-title">Inventario y Almacén</div>
                        <div class="mod-desc">Stock, movimientos, traslados entre almacenes y mermas</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">@ViewBag.StockTotal unidades</span>
                            <span class="mod-stat-pill danger">@ViewBag.StockCritico crítico</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Revisar →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

                @if (userRole == "SuperAdmin" || userRole == "AdminVentas")
                {
                    <a class="mod-card" href="/Ventas">
                        <div class="mod-card-accent ven"></div>
                        <div class="mod-top">
                            <div class="mod-icon ven">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
                                </svg>
                            </div>
                            <span class="mod-badge success">Ventas activas</span>
                        </div>
                        <div class="mod-title">Ventas y Clientes</div>
                        <div class="mod-desc">Pedidos, facturación, cartera de clientes y precios especiales</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">Bs. @ViewBag.VentasHoyMonto hoy</span>
                            <span class="mod-stat-pill">@ViewBag.ClientesActivos clientes</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Ver ventas →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

                @if (userRole == "SuperAdmin" || userRole == "AdminCompras")
                {
                    <a class="mod-card" href="/Compras">
                        <div class="mod-card-accent comp"></div>
                        <div class="mod-top">
                            <div class="mod-icon comp">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                                </svg>
                            </div>
                            <span class="mod-badge neutral">Pendientes</span>
                        </div>
                        <div class="mod-title">Compras y Logística</div>
                        <div class="mod-desc">Proveedores, órdenes de compra, despachos y flota propia</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">@ViewBag.OrdenesCompra órdenes</span>
                            <span class="mod-stat-pill">@ViewBag.ProveedoresActivos proveedores</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Gestionar →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

                @if (userRole == "SuperAdmin" || userRole == "AdminRRHH")
                {
                    <a class="mod-card" href="/RRHH/RegistrarAsistencia">
                        <div class="mod-card-accent rrhh"></div>
                        <div class="mod-top">
                            <div class="mod-icon rrhh">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke-width="2" stroke-linecap="round">
                                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span class="mod-badge neutral">Planilla activa</span>
                        </div>
                        <div class="mod-title">Recursos Humanos</div>
                        <div class="mod-desc">Empleados, planilla de salarios, asistencia y evaluaciones</div>
                        <div class="mod-stats-row">
                            <span class="mod-stat-pill">@ViewBag.EmpleadosPorSucursal empleados</span>
                            <span class="mod-stat-pill">@ViewBag.AsistenciaHoy asist. hoy</span>
                        </div>
                        <div class="mod-footer">
                            <span class="mod-link">Gestionar RRHH →</span>
                            <svg class="mod-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </a>
                }

            </div>
        </div>

        <!-- PANEL LATERAL -->
        <div class="side-panel">

            <!-- Accesos rápidos -->
            <div class="quick-card">
                <div class="quick-title">Accesos rápidos</div>
                <div class="quick-sub">Operaciones frecuentes del día</div>
                <div class="quick-links">
                    <a href="/Ventas/NuevoPedido" class="quick-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                        Nuevo pedido
                    </a>
                    <a href="/Inventario/Movimientos" class="quick-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round"><polyline points="17 8 21 12 17 16"/><polyline points="7 8 3 12 7 16"/><line x1="21" y1="12" x2="3" y2="12"/></svg>
                        Movimiento de stock
                    </a>
                    <a href="/RRHH/RegistrarAsistencia" class="quick-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Registrar asistencia
                    </a>
                    <a href="/Produccion/Ordenes" class="quick-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Órdenes de producción
                    </a>
                    <a href="/Seguridad/Auditoria" class="quick-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        Bitácora del sistema
                    </a>
                </div>
            </div>

            <!-- Estado del sistema -->
            <div class="status-card">
                <div class="status-card-title">Estado del sistema</div>
                <div class="status-list">
                    <div class="status-item">
                        <div class="status-item-left">
                            <div class="status-dot ok"></div>
                            <span class="status-item-name">Base de datos</span>
                        </div>
                        <span class="status-item-val">Operativo</span>
                    </div>
                    <div class="status-item">
                        <div class="status-item-left">
                            <div class="status-dot ok"></div>
                            <span class="status-item-name">Autenticación</span>
                        </div>
                        <span class="status-item-val">Activa</span>
                    </div>
                    <div class="status-item">
                        <div class="status-item-left">
                            <div class="status-dot @(ViewBag.StockCritico > 0 ? "warn" : "ok")"></div>
                            <span class="status-item-name">Inventario</span>
                        </div>
                        <span class="status-item-val">@(ViewBag.StockCritico > 0 ? "Atención" : "Normal")</span>
                    </div>
                    <div class="status-item">
                        <div class="status-item-left">
                            <div class="status-dot ok"></div>
                            <span class="status-item-name">Módulo Ventas</span>
                        </div>
                        <span class="status-item-val">En línea</span>
                    </div>
                    <div class="status-item">
                        <div class="status-item-left">
                            <div class="status-dot ok"></div>
                            <span class="status-item-name">Email / OTP</span>
                        </div>
                        <span class="status-item-val">Configurado</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ACTIVIDAD RECIENTE -->
    <div class="section-label">
        <span class="section-label-text">Actividad reciente</span>
        <div class="section-label-line"></div>
    </div>
    <div class="activity-card">
        <div class="activity-card-header">
            <div>
                <div class="activity-card-title">Registro de actividad</div>
                <div class="activity-card-sub">Últimas acciones registradas en el sistema</div>
            </div>
            <a href="/Seguridad/Auditoria" class="activity-see-all">Ver todo →</a>
        </div>
        <div class="activity-list">
            @if (ViewBag.ActividadReciente != null && ViewBag.ActividadReciente.Count > 0)
            {
                @foreach (var actividad in ViewBag.ActividadReciente)
                {
                    <div class="act-item">
                        <div class="act-icon-wrap @actividad.Tipo">
                            @if (actividad.Tipo == "login")
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke-width="2" stroke-linecap="round">
                                    <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                                </svg>
                            }
                            else if (actividad.Tipo == "venta")
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke-width="2" stroke-linecap="round">
                                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke-width="2" stroke-linecap="round">
                                    <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
                                </svg>
                            }
                        </div>
                        <div class="act-content">
                            <div class="act-text">@actividad.Descripcion</div>
                            <div class="act-time">@actividad.Fecha.ToString("HH:mm") · @actividad.Fecha.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="act-empty">Sin actividad reciente registrada</div>
            }
        </div>
    </div>

</div>
